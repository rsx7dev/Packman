<UserControl x:Class="Packman.Views.StepGenerate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <!-- Step 1 of the wizard. The rail beside it (WizardRail) shows what this form doesn't:
         the resolved package folder, installer type, product code and what's still missing. -->
    <StackPanel>

        <!-- ═══ Generated: the optional tools, before moving on to Configure ═══ -->
        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12"
                Visibility="{Binding HasPackage, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Start a new package"
                            Command="{Binding NewPackageCommand}" VerticalAlignment="Top"/>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,12,0">
                        <Ellipse Fill="{DynamicResource OkBrush}"/>
                        <Path Data="M6.4 11.4l3.2 3.2 6-6.2" Stroke="{DynamicResource BgBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="Package generated" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding CreatePackage.CurrentPackagePath}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="Optional before publishing" Style="{StaticResource H3}" Margin="0,22,0,4"/>
                <TextBlock Text="The installer details are saved in the package. Check the script and test it before you configure the deployment."
                           Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <UniformGrid Rows="1">
                    <Button Command="{Binding OpenEditToolCommand}" Style="{StaticResource ToolCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource InkBrush}">
                                <controls:LineIcon Data="{DynamicResource IconCode}"/>
                                <TextBlock Text="Edit script" Margin="9,0,0,0" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Review the install and uninstall logic in Invoke-AppDeployToolkit.ps1."/>
                                        <Style.Triggers>
                                            <!-- An EXE can't run silently until its real switches are in the script. -->
                                            <DataTrigger Binding="{Binding CreatePackage.IsExeInstaller}" Value="True">
                                                <Setter Property="Text" Value="Needed for EXE installers: set the vendor's real silent switches."/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenTestToolCommand}" Style="{StaticResource ToolCard}" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource InkBrush}">
                                <controls:LineIcon Data="{DynamicResource IconLaptop}"/>
                                <TextBlock Text="Remote test" Margin="9,0,0,0" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Install on a test device and discover a detection rule." Margin="0,8,0,0"
                                       FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenPackageFolderCommand}" Style="{StaticResource ToolCard}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource InkBrush}">
                                <controls:LineIcon Data="{DynamicResource IconFolder}"/>
                                <TextBlock Text="Open folder" Margin="9,0,0,0" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Inspect the package on the network share." Margin="0,8,0,0"
                                       FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ═══ The form ═══ -->
        <Border Style="{StaticResource SectionPanel}">
            <StackPanel>
                <!-- Title + mode -->
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" IsEnabled="{Binding CanEditPackageInputs}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ModeToggle}" Content="Create new"
                                         IsChecked="{Binding IsUpgradeMode, Mode=TwoWay, Converter={StaticResource InverseBool}}"/>
                            <RadioButton Style="{StaticResource ModeToggle}" Content="Upgrade existing"
                                         IsChecked="{Binding IsUpgradeMode, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Package" Style="{StaticResource H1}" FontSize="20" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource SectionRule}" Margin="0,16,0,18"/>

                <!-- ═══ CREATE NEW ═══ -->
                <StackPanel x:Name="SourceFields" IsEnabled="{Binding CanEditPackageInputs}"
                            Visibility="{Binding IsUpgradeMode, Converter={StaticResource InverseBoolToVis}}">
                    <controls:SectionHeader Title="Start with your installer"
                                            Caption="Choose the source first. Review the detected details before generating your package."/>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,7">
                        <Run Text="Source installer"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                    </TextBlock>
                    <!-- Drop zone: the whole dashed area takes a dropped file, not just the field. -->
                    <Grid AllowDrop="True" PreviewDragOver="SourcesPath_DragOver" Drop="SourcesPath_Drop" Background="Transparent">
                        <Rectangle RadiusX="6" RadiusY="6" Stroke="{DynamicResource ControlStrokeBrush}" StrokeThickness="1.2"
                                   StrokeDashArray="4 3" Fill="{DynamicResource Card2Brush}" SnapsToDevicePixels="True"/>
                        <Grid Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource PrimaryFaintBrush}"
                                    Margin="0,0,12,0" TextElement.Foreground="{DynamicResource AccentTextBrush}">
                                <controls:LineIcon Data="{DynamicResource IconUpload}" Width="18" Height="18" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBox Grid.Column="1" AutomationProperties.Name="Source installer" Style="{StaticResource MonoField}"
                                     local:PlaceholderText.Text="Choose or drop an MSI / EXE installer"
                                     Text="{Binding CreatePackage.SourcesPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewDragOver="SourcesPath_DragOver" Drop="SourcesPath_Drop" AllowDrop="True"/>
                            <Button Grid.Column="2" Style="{StaticResource FieldActionButton}" Content="Browse…"
                                    Click="BrowseButton_Click"/>
                        </Grid>
                    </Grid>
                    <TextBlock Text="Drop an MSI or EXE here. Metadata, icon and product code are read automatically."
                               Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource SectionRule}"/>

                    <controls:SectionHeader Title="Application details" Caption="Read from the installer. Correct anything that's wrong."/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Manufacturer"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Manufacturer" Style="{StaticResource TextField}"
                                     local:PlaceholderText.Text="e.g. Mozilla"
                                     Text="{Binding CreatePackage.Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Application name"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Application name" Style="{StaticResource TextField}"
                                     local:PlaceholderText.Text="e.g. Firefox"
                                     Text="{Binding CreatePackage.AppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Version"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Version" Style="{StaticResource MonoField}"
                                     local:PlaceholderText.Text="e.g. 124.0.1"
                                     Text="{Binding CreatePackage.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Text="Architecture" Style="{StaticResource FieldLabel}"/>
                            <ComboBox AutomationProperties.Name="Architecture" SelectedValuePath="Content"
                                      SelectedValue="{Binding CreatePackage.Architecture, Mode=TwoWay}">
                                <ComboBoxItem Content="x64"/>
                                <ComboBoxItem Content="x86"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Install context" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                    <DockPanel>
                        <Border Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ContextToggle}" Content="System" MinWidth="90"
                                             IsChecked="{Binding CreatePackage.UserInstall, Mode=TwoWay, Converter={StaticResource InverseBool}}"/>
                                <RadioButton Style="{StaticResource ContextToggle}" Content="User" MinWidth="90"
                                             IsChecked="{Binding CreatePackage.UserInstall, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted2Brush}" Text="{Binding CreatePackage.InstallContextHelp}"/>
                    </DockPanel>

                    <Border Style="{StaticResource SectionRule}"/>

                    <!-- Output: where the package is written. The share is a setting, so it's shown, not edited here. -->
                    <controls:SectionHeader Title="Output"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output share" FontSize="13" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding OutputShare}" FontFamily="{StaticResource MonoFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding OutputShare}"/>
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Change in Settings" Margin="12,0,0,0"
                                Click="OpenSettings_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal"><controls:LineIcon Data="{DynamicResource IconFolder}" Width="13" Height="13"/><TextBlock Text="Application\" Margin="6,0,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal"><controls:LineIcon Data="{DynamicResource IconFolder}" Width="13" Height="13"/><TextBlock Text="Intune\" Margin="6,0,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal"><controls:LineIcon Data="{DynamicResource IconFolder}" Width="13" Height="13"/><TextBlock Text="Icon\" Margin="6,0,0,0"/></StackPanel>
                        </Border>
                        <TextBlock Text="are created inside the package folder." Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>

                <!-- ═══ UPGRADE EXISTING ═══ -->
                <StackPanel IsEnabled="{Binding CanEditPackageInputs}"
                            Visibility="{Binding IsUpgradeMode, Converter={StaticResource BoolToVis}}">
                    <controls:SectionHeader Title="Upgrade an existing package"
                                            Caption="Creates a new version that reuses the existing install logic, Files and script edits."/>

                    <TextBlock Text="Existing package folder" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox AutomationProperties.Name="Existing package folder" Style="{StaticResource MonoField}" IsReadOnly="True"
                                 local:PlaceholderText.Text="Select the existing PSADT package folder"
                                 Text="{Binding Upgrade.ExistingPackagePath, Mode=OneWay}"/>
                        <Button Grid.Column="1" Style="{StaticResource FieldActionButton}" Content="Browse…"
                                Click="BrowseUpgradePackage_Click"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="New source file" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="New source file" Style="{StaticResource MonoField}" IsReadOnly="True"
                                         local:PlaceholderText.Text="Select the new MSI/EXE"
                                         Text="{Binding Upgrade.NewSourcePath, Mode=OneWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource FieldActionButton}" Content="Browse…"
                                        Click="BrowseUpgradeSource_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="New version" Style="{StaticResource FieldLabel}"/>
                            <TextBox AutomationProperties.Name="New version" Style="{StaticResource MonoField}"
                                     local:PlaceholderText.Text="e.g. 125.0"
                                     Text="{Binding Upgrade.NewVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CalloutNeutral}" Margin="0,18,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                   Text="If the existing package was published from Packman, the new version supersedes it in Intune. You can review this on Configure."/>
                    </Border>
                </StackPanel>

                <!-- Generation / upgrade status -->
                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Muted2Brush}" AutomationProperties.LiveSetting="Polite"
                           Text="{Binding CreatePackage.StatusText}"
                           Visibility="{Binding CreatePackage.StatusText, Converter={StaticResource NonEmptyToVis}}"/>
                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Muted2Brush}" AutomationProperties.LiveSetting="Polite"
                           Text="{Binding Upgrade.StatusText}"
                           Visibility="{Binding IsUpgradeMode, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Cross-link for a package built elsewhere. -->
        <TextBlock Margin="4,14,0,4" FontSize="12.5" HorizontalAlignment="Left">
            <Run Text="Already have a built package?" Foreground="{DynamicResource Muted2Brush}"/>
            <Hyperlink Click="UploadExisting_Click" Foreground="{DynamicResource AccentTextBrush}" TextDecorations="{x:Null}" FontWeight="SemiBold">Upload it directly</Hyperlink>
        </TextBlock>
    </StackPanel>
</UserControl>
