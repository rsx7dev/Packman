<UserControl x:Class="Packman.Views.ApplicationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             xmlns:local="clr-namespace:Packman"
             xmlns:views="clr-namespace:Packman.Views"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:services="clr-namespace:Packman.Services"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApplicationDetailViewModel}"
             FontFamily="{StaticResource UIFontFamily}">

    <UserControl.Resources>
        <!-- Read-only fact: label column + value, for the two-column information grid. -->
        <Style x:Key="Fact" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="13" Foreground="{DynamicResource Muted2Brush}"
                                       TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <ContentPresenter Grid.Column="1" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontSize="13">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table column head inside a section. -->
        <Style x:Key="TableHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Requirement tile label + value. -->
        <Style x:Key="ReqLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ReqValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Mono field in the inline rule editor. -->
        <Style x:Key="RuleField" TargetType="TextBox" BasedOn="{StaticResource TextField}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- "Saved to Intune immediately" note next to edit controls. -->
        <Style x:Key="WriteNote" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted2Brush}"/>
        </Style>
    </UserControl.Resources>

    <controls:PageFrame Title="{Binding Detail.DisplayName}" Subtitle="{Binding HeaderMeta}" IsBodyScrollable="False">

        <controls:PageFrame.Breadcrumb>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Breadcrumb}" Content="Applications" FontFamily="{StaticResource UIFontFamily}"
                        FontSize="13" Click="Back_Click"/>
                <TextBlock Text="  /  " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Detail.DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StackPanel>
        </controls:PageFrame.Breadcrumb>

        <controls:PageFrame.Leading>
            <controls:AppIdentity Title="{Binding Detail.DisplayName}" TileSize="64" IsTileOnly="True"/>
        </controls:PageFrame.Leading>

        <controls:PageFrame.HeaderActions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Click="Update_Click" IsEnabled="{Binding CanRepublish}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Rebuild content for this same Intune app. Needs the package folder on the share and a sign-in. For a new app version with supersedence, use Create package, Upgrade existing.">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconUpload}"/>
                        <TextBlock Text="Republish content" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="EditScript_Click"
                        IsEnabled="{Binding HasSource}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Open the PSADT script from the source share">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconCode}"/>
                        <TextBlock Text="Edit script" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageFrame.HeaderActions>

        <controls:PageFrame.HeaderBottom>
            <StackPanel Orientation="Horizontal" Margin="-10,0,0,0">
                <RadioButton Style="{StaticResource PageTab}" Content="Overview"
                             IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=overview}"/>
                <RadioButton Style="{StaticResource PageTab}" Content="Package"
                             IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=package}"/>
                <RadioButton Style="{StaticResource PageTab}" Content="Deployment"
                             IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=deployment}"/>
            </StackPanel>
        </controls:PageFrame.HeaderBottom>

        <!-- ═══════ Rail: deployment status and Intune publishing, on every tab ═══════ -->
        <controls:PageFrame.Rail>
            <StackPanel>
                <TextBlock Text="Deployment status" Style="{StaticResource RailTitle}"/>

                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Line2Brush}" ClipToBounds="True" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding SumInstalled, Converter={StaticResource CountToStar}}"/>
                                <ColumnDefinition Width="{Binding SumPending, Converter={StaticResource CountToStar}}"/>
                                <ColumnDefinition Width="{Binding SumFailed, Converter={StaticResource CountToStar}}"/>
                                <ColumnDefinition Width="{Binding SumRemaining, Converter={StaticResource CountToStar}}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource OkBrush}"/>
                            <Border Grid.Column="1" Background="{DynamicResource WarnBrush}"/>
                            <Border Grid.Column="2" Background="{DynamicResource BadBrush}"/>
                        </Grid>
                    </Border>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Targeted" Content="{Binding TargetedDevicesText}"/>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Installed" Content="{Binding SumInstalled}"/>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Pending" Content="{Binding SumPending}"/>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Failed" Content="{Binding SumFailed}"/>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Not installed" Content="{Binding SumNotInstalled}"/>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Not applicable" Content="{Binding SumNotApplicable}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatsEmptyText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasSummary, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- Signed out: the figures are a snapshot and nothing can be written. -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding LastSyncedText}" Style="{StaticResource SubText}" Margin="0,0,0,10"
                               Visibility="{Binding LastSyncedText, Converter={StaticResource NonEmptyToVis}}"/>
                    <Border Style="{StaticResource Callout}">
                        <DockPanel>
                            <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconInfo}" VerticalAlignment="Top"
                                               Margin="0,2,10,0" Foreground="{DynamicResource AccentTextBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Not connected. Figures are from the last sync. Sign in to make changes."
                                           FontSize="13" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource LinkButton}" Content="Sign in" HorizontalAlignment="Left" Margin="-2,6,0,0"
                                        Command="{x:Static services:AppNavigation.OpenSettings}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SectionRule}" Margin="0,24"/>

                <TextBlock Text="Intune publishing" Style="{StaticResource RailTitle}"/>
                <StackPanel Margin="0,10,0,0">
                    <controls:StatusRow Label="State" Value="{Binding Detail.StatusLabel}" Kind="{Binding Detail.StatusKind}"/>
                    <ContentControl Style="{StaticResource KvRowMono}" Tag="App ID">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Detail.IdShort}" VerticalAlignment="Center" ToolTip="{Binding Detail.Id}"/>
                            <Button Style="{StaticResource RowIconButton}" Width="24" Height="24" Margin="6,-4,0,-4"
                                    Click="CopyAppId_Click" ToolTip="Copy full App ID">
                                <controls:LineIcon Data="{DynamicResource IconCopy}" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Created" Content="{Binding Detail.CreatedFormatted}"/>
                    <ContentControl Style="{StaticResource KvRow}" Tag="Last modified" Content="{Binding Detail.LastModifiedFormatted}"/>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Margin="0,16,0,0" Click="ViewInIntune_Click"
                        ToolTip="Open this app in the Intune admin center">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconExternal}"/>
                        <TextBlock Text="View in Intune" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageFrame.Rail>

        <!-- Body scrolls on its own so the update overlay and the members slide-over
             stay put over it. -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>

                    <Border Style="{StaticResource CalloutBad}" Margin="0,0,0,12"
                            Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVis}}">
                        <DockPanel>
                            <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" VerticalAlignment="Top"
                                               Margin="0,2,10,0" Foreground="{DynamicResource BadBrush}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- ═══════ OVERVIEW ═══════ -->
                    <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <controls:SectionHeader Title="Application information" Caption="Key details about this application."/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ContentControl Style="{StaticResource Fact}" Tag="Publisher" Content="{Binding Detail.Publisher}"/>
                                        <ContentControl Style="{StaticResource Fact}" Tag="Version" Content="{Binding Detail.Version}"/>
                                        <ContentControl Style="{StaticResource Fact}" Tag="Category" Content="{Binding CategoryText}"/>
                                        <ContentControl Style="{StaticResource Fact}" Tag="Owner" Content="{Binding OwnerText}" Margin="0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}" Margin="24,0"/>
                                    <StackPanel Grid.Column="2">
                                        <ContentControl Style="{StaticResource Fact}" Tag="Package type" Content="Win32 (.intunewin)"/>
                                        <ContentControl Style="{StaticResource Fact}" Tag="File size" Content="{Binding Detail.SizeFormatted}"/>
                                        <ContentControl Style="{StaticResource Fact}" Tag="Install context" Content="{Binding Detail.InstallContext}"/>
                                        <ContentControl Style="{StaticResource Fact}" Tag="Last modified" Content="{Binding Detail.LastModifiedFormatted}" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Visibility="{Binding Detail.Description, Converter={StaticResource NonEmptyToVis}}">
                                    <Border Style="{StaticResource SectionRule}" Margin="0,20,0,16"/>
                                    <TextBlock Text="Description" FontSize="13" Foreground="{DynamicResource Muted2Brush}"/>
                                    <TextBlock Text="{Binding Detail.Description}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Assignments at a glance; managed on the Deployment tab. -->
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:SectionHeader Title="Assignments" Caption="Groups this application is assigned to."/>
                                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="16,0,0,0"
                                            Click="ManageAssignments_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Manage in Deployment" VerticalAlignment="Center"/>
                                            <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Detail.AssignedGroups}" Margin="0,12,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <controls:LineIcon Data="{DynamicResource IconGroup}" Foreground="{DynamicResource Muted2Brush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" Margin="12,0,12,0" VerticalAlignment="Center"
                                                               TextWrapping="Wrap"/>
                                                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                                                    VerticalAlignment="Center" Focusable="False"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No assignments yet." Style="{StaticResource SubText}" Margin="0,12,0,0"
                                           Visibility="{Binding HasAssignments, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Source path only; everything actionable lives on the Package tab. -->
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <controls:SectionHeader Title="Package source" Caption="Location of the application package files."/>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Source path" FontSize="13" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SourcePathDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourcePathDisplay}"/>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="CopyPath_Click"
                                            IsEnabled="{Binding HasSource}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LineIcon Data="{DynamicResource IconCopy}"/>
                                            <TextBlock Text="Copy" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Danger zone: out of the always-visible rail, at the end of the overview. -->
                        <Border Style="{StaticResource SectionPanel}" BorderBrush="{DynamicResource BadLineBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:SectionHeader Title="Danger zone"
                                                        Caption="Deleting removes this app and its assignments from Intune. It does not uninstall the app from devices; to remove it there, assign it as Uninstall first."/>
                                <Button Grid.Column="1" Style="{StaticResource DangerButton}" VerticalAlignment="Center" Margin="20,0,0,0"
                                        Click="Retire_Click" IsEnabled="{Binding IsSignedIn}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{DynamicResource IconTrash}"/>
                                        <TextBlock Text="Delete from Intune" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══════ PACKAGE ═══════ -->
                    <StackPanel Visibility="{Binding IsPackage, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <controls:SectionHeader Title="Package source" Caption="Location of the application package files."/>
                                <TextBlock Text="Network share location" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="12,9" MinHeight="40">
                                        <TextBlock Text="{Binding SourcePathDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourcePathDisplay}"/>
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="CopyPath_Click"
                                            IsEnabled="{Binding HasSource}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LineIcon Data="{DynamicResource IconCopy}"/>
                                            <TextBlock Text="Copy" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OpenFolder_Click"
                                            IsEnabled="{Binding HasSource}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LineIcon Data="{DynamicResource IconFolder}"/>
                                            <TextBlock Text="Open folder" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <DockPanel Margin="0,12,0,0">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource OkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SourceHintOk}" Value="False">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <controls:LineIcon DockPanel.Dock="Left" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,8,0">
                                        <controls:LineIcon.Style>
                                            <Style TargetType="controls:LineIcon" BasedOn="{StaticResource {x:Type controls:LineIcon}}">
                                                <Setter Property="Data" Value="{DynamicResource IconCheck}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceHintOk}" Value="False">
                                                        <Setter Property="Data" Value="{DynamicResource IconAlert}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:LineIcon.Style>
                                    </controls:LineIcon>
                                    <TextBlock Text="{Binding SourceHintText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Integrity: key files on the share, checked against the Intune record. -->
                        <Border Style="{StaticResource SectionPanel}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <controls:SectionHeader Title="Package integrity" Caption="Key files on the share, checked against the Intune record."/>
                                <ItemsControl ItemsSource="{Binding SourceChecks}" Margin="0,10,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:StatusRow Label="{Binding File}" Detail="{Binding Note}"
                                                                Kind="{Binding IsOk, Converter={StaticResource BoolToText}, ConverterParameter='ok|warn'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════ DEPLOYMENT ═══════ -->
                    <StackPanel Visibility="{Binding IsDeployment, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <controls:SectionHeader Title="Command lines" Caption="Intune runs these to install and uninstall the application."/>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Install command" FontSize="13" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail.InstallCommand}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="CopyInstall_Click"
                                            AutomationProperties.Name="Copy install command">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LineIcon Data="{DynamicResource IconCopy}" Width="15" Height="15"/>
                                            <TextBlock Text="Copy" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Line2Brush}" Margin="0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Uninstall command" FontSize="13" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail.UninstallCommand}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="CopyUninstall_Click"
                                            AutomationProperties.Name="Copy uninstall command">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LineIcon Data="{DynamicResource IconCopy}" Width="15" Height="15"/>
                                            <TextBlock Text="Copy" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Detection rules: type + summary per rule, edited in place. -->
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:SectionHeader Title="Detection rules" Caption="How Intune checks that the application is installed on a device."/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <ComboBox x:Name="NewRuleType" AutomationProperties.Name="New rule type" Width="110" SelectedIndex="0"
                                                  IsEnabled="{Binding IsSignedIn}">
                                            <ComboBoxItem Content="MSI"/>
                                            <ComboBoxItem Content="File"/>
                                            <ComboBoxItem Content="Registry"/>
                                        </ComboBox>
                                        <Button Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="AddRule_Click" IsEnabled="{Binding IsSignedIn}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:LineIcon Data="{DynamicResource IconPlus}" Width="15" Height="15"/>
                                                <TextBlock Text="Add rule" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DockPanel Style="{StaticResource WriteNote}">
                                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconInfo}" Width="15" Height="15"
                                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                                               Text="Changes are saved to Intune as soon as you save or delete a rule. Devices re-evaluate detection at their next check-in."/>
                                </DockPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Type" Style="{StaticResource TableHead}"/>
                                    <TextBlock Grid.Column="1" Text="Rule" Style="{StaticResource TableHead}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DetectionRulesHint}" Style="{StaticResource Caption}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10,0,0"/>

                                <ItemsControl ItemsSource="{Binding DetectionDisplays}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <StackPanel>
                                                    <!-- Read row -->
                                                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeTag}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Margin="12,0,0,0" Click="EditRule_Click" ToolTip="Edit rule"
                                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                                IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType={x:Type views:ApplicationDetailView}}}">
                                                            <controls:LineIcon Data="{DynamicResource IconPencil}" Width="15" Height="15"/>
                                                        </Button>
                                                        <Button Grid.Column="3" Style="{StaticResource RowIconButton}" Margin="4,0,0,0" Click="DeleteRule_Click" ToolTip="Delete rule"
                                                                IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType={x:Type views:ApplicationDetailView}}}">
                                                            <controls:LineIcon Data="{DynamicResource IconTrash}" Width="15" Height="15"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Inline editor: the row turns into a focused card. -->
                                                    <Border Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                            Background="{DynamicResource Card2Brush}" BorderBrush="{DynamicResource AccentTextBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="18,16">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                                <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TypeTag}"/>
                                                                </Border>
                                                                <TextBlock Text="Edit detection rule" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- MSI -->
                                                            <StackPanel Visibility="{Binding IsMsi, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Product code" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox AutomationProperties.Name="Product code" Style="{StaticResource RuleField}"
                                                                         Text="{Binding EditPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <CheckBox Content="Check product version" IsChecked="{Binding EditCheckVersion, Mode=TwoWay}"
                                                                          Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,12,0,0"/>
                                                            </StackPanel>

                                                            <!-- File -->
                                                            <Grid Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="Path" Style="{StaticResource FieldLabel}"/>
                                                                    <TextBox AutomationProperties.Name="Path" Style="{StaticResource RuleField}"
                                                                             Text="{Binding EditPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="File or folder" Style="{StaticResource FieldLabel}"/>
                                                                    <TextBox AutomationProperties.Name="File or folder" Style="{StaticResource RuleField}"
                                                                             Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Registry -->
                                                            <Grid Visibility="{Binding IsRegistry, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="Key path" Style="{StaticResource FieldLabel}"/>
                                                                    <TextBox AutomationProperties.Name="Key path" Style="{StaticResource RuleField}"
                                                                             Text="{Binding EditPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Value name (empty for the key itself)" Style="{StaticResource FieldLabel}"/>
                                                                    <TextBox AutomationProperties.Name="Value name" Style="{StaticResource RuleField}"
                                                                             Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Detection method, operator and value -->
                                                            <WrapPanel Margin="0,4,0,0">
                                                                <StackPanel Margin="0,8,12,0" Visibility="{Binding IsFileOrRegistry, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Detection method" Style="{StaticResource FieldLabel}"/>
                                                                    <ComboBox AutomationProperties.Name="Detection method" Width="190"
                                                                              ItemsSource="{Binding DetectionTypeChoices}" DisplayMemberPath="Label"
                                                                              SelectedValuePath="Value" SelectedValue="{Binding EditDetectionType, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,8,12,0" Visibility="{Binding EditNeedsValue, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
                                                                    <ComboBox AutomationProperties.Name="Operator" Width="90"
                                                                              ItemsSource="{Binding OperatorChoices}" DisplayMemberPath="Label"
                                                                              SelectedValuePath="Value" SelectedValue="{Binding EditOperator, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding EditNeedsValue, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Value" Style="{StaticResource FieldLabel}"/>
                                                                    <TextBox AutomationProperties.Name="Value" Style="{StaticResource RuleField}" Width="220"
                                                                             Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                            </WrapPanel>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CancelRule_Click" Margin="0,0,10,0"/>
                                                                <Button Style="{StaticResource PrimaryButton}" Content="Save rule" Click="SaveRule_Click"
                                                                        IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType={x:Type views:ApplicationDetailView}}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No detection rules found for this app." Style="{StaticResource SubText}" Margin="0,12,0,0"
                                           Visibility="{Binding HasDetectionRules, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Requirements -->
                        <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <controls:SectionHeader Title="Requirements" Caption="What a device needs before Intune installs the application."/>
                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                    <StackPanel Margin="0,12,16,0">
                                        <TextBlock Text="Minimum Windows release" Style="{StaticResource ReqLabel}"/>
                                        <TextBlock Text="{Binding Detail.MinimumOperatingSystem}" Style="{StaticResource ReqValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,12,16,0">
                                        <TextBlock Text="Install context" Style="{StaticResource ReqLabel}"/>
                                        <TextBlock Text="{Binding Detail.InstallContext}" Style="{StaticResource ReqValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,12,16,0">
                                        <TextBlock Text="Restart behavior" Style="{StaticResource ReqLabel}"/>
                                        <TextBlock Text="{Binding Detail.RestartBehaviorText}" Style="{StaticResource ReqValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,12,16,0">
                                        <TextBlock Text="Maximum install time" Style="{StaticResource ReqLabel}"/>
                                        <TextBlock Text="{Binding Detail.MaxRunTimeText}" Style="{StaticResource ReqValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,12,16,0">
                                        <TextBlock Text="Disk space" Style="{StaticResource ReqLabel}"/>
                                        <TextBlock Text="{Binding Detail.MinDiskSpaceText}" Style="{StaticResource ReqValue}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Assignment groups: select a row for members, remove, add inline. -->
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <controls:SectionHeader Title="Assignment groups" Caption="Select a group to see and manage its members."/>
                                <DockPanel Style="{StaticResource WriteNote}">
                                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconInfo}" Width="15" Height="15"
                                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                                               Text="Adding or removing an assignment updates Intune immediately. Devices pick it up at their next check-in."/>
                                </DockPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Group" Style="{StaticResource TableHead}"/>
                                    <TextBlock Grid.Column="1" Text="Intent" Style="{StaticResource TableHead}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10,0,0"/>

                                <ItemsControl ItemsSource="{Binding Detail.AssignedGroups}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="GroupRow_Click" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="View members"
                                                    AutomationProperties.Name="{Binding GroupName}" FocusVisualStyle="{StaticResource FocusVisualInset}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="rb" Background="Transparent" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="rb" Property="Background" Value="{DynamicResource Card2Brush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid Margin="0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <controls:LineIcon Data="{DynamicResource IconGroup}" Foreground="{DynamicResource Muted2Brush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" Margin="12,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                                                    VerticalAlignment="Center" Focusable="False"/>
                                                    <Button Grid.Column="3" Style="{StaticResource RowIconButton}" HorizontalAlignment="Right"
                                                            Click="RemoveAssignment_Click" ToolTip="Remove this assignment"
                                                            IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType={x:Type views:ApplicationDetailView}}}">
                                                        <controls:LineIcon Data="{DynamicResource IconX}" Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No assignments yet." Style="{StaticResource SubText}" Margin="0,12,0,0"
                                           Visibility="{Binding HasAssignments, Converter={StaticResource InverseBoolToVis}}"/>

                                <!-- Inline add: search Entra groups, pick an intent, add. -->
                                <TextBlock Text="Add assignment" Style="{StaticResource FieldLabel}" Margin="0,20,0,7"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource TextField}" AutomationProperties.Name="Search Entra groups"
                                             local:PlaceholderText.Text="Search Entra groups"
                                             Text="{Binding GroupSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsSignedIn}"/>
                                    <ComboBox Grid.Column="1" Width="130" Margin="10,0,0,0" AutomationProperties.Name="Assignment intent"
                                              ItemsSource="{Binding IntentChoices}" SelectedItem="{Binding SelectedIntent, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSignedIn}"/>
                                    <Button Grid.Column="2" Style="{StaticResource FieldActionButton}" Content="Add group"
                                            Click="AddAssignment_Click" IsEnabled="{Binding CanAddAssignment}"/>
                                </Grid>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,8,0,0" MaxHeight="180"
                                        Visibility="{Binding HasGroupResults, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GroupResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="GroupResult_Click" Style="{StaticResource PickerRow}" AutomationProperties.Name="{Binding DisplayName}">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="12,8"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ Package update overlay ═══════
                 The rebuild + upload runs for minutes and must not race edits made on the
                 page behind it, so it covers the body until it finishes. -->
            <Grid Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource BgBrush}" Opacity="0.75" CornerRadius="8"/>
                <Border Style="{StaticResource PanelCard}" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource ControlStrokeBrush}"
                        Width="420" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Updating package content" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Detail.DisplayName}" Style="{StaticResource SubText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Value="{Binding UpdatePercent, Mode=OneWay}" Maximum="100" Margin="0,18,0,0"/>
                        <TextBlock Text="{Binding UpdateStatus}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource Muted2Brush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Right"
                                Margin="0,18,0,0" Click="CancelUpdate_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════ Group members slide-over ═══════
                 A group is a different object with blast radius beyond this app, so it gets
                 its own surface; the app stays visible (dimmed) behind it. -->
            <Border Background="{DynamicResource BgBrush}" Opacity="0.6" CornerRadius="8"
                    Visibility="{Binding IsFlyoutOpen, Converter={StaticResource BoolToVis}}"
                    MouseLeftButtonDown="FlyoutBackdrop_MouseDown"/>
            <Border HorizontalAlignment="Right" Width="360" Style="{StaticResource PanelCard}"
                    Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource ControlStrokeBrush}"
                    Visibility="{Binding IsFlyoutOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding FlyoutGroup.GroupName}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                            <ContentControl Content="{Binding FlyoutGroup}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Focusable="False"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource RowIconButton}" Click="FlyoutClose_Click" ToolTip="Close" VerticalAlignment="Top">
                            <controls:LineIcon Data="{DynamicResource IconX}" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <!-- Blast-radius warning -->
                    <Border Grid.Row="1" Style="{StaticResource CalloutWarn}" Margin="0,0,0,14"
                            Visibility="{Binding FlyoutHasGroup, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" VerticalAlignment="Top"
                                               Margin="0,2,10,0" Foreground="{DynamicResource WarnBrush}"/>
                            <TextBlock Text="Membership changes affect every app assigned to this group, not just this one. They are saved to Entra ID immediately."
                                       FontSize="13" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding FlyoutHasGroup, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Add member" Style="{StaticResource FieldLabel}"/>
                        <TextBox AutomationProperties.Name="Add member" Style="{StaticResource TextField}"
                                 local:PlaceholderText.Text="Search devices or users"
                                 Text="{Binding MemberSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsSignedIn}"/>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="4" Margin="0,0,0,8" MaxHeight="160"
                            Visibility="{Binding HasMemberResults, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MemberSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="MemberResult_Click" Style="{StaticResource PickerRow}" ToolTip="Add to group"
                                                AutomationProperties.Name="{Binding DisplayName}">
                                            <Grid Margin="12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Muted2Brush}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="4" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding FlyoutHasGroup, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Members}" Margin="12,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{DynamicResource InkBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Muted2Brush}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Width="26" Height="26" Margin="4,0,0,0"
                                                        Click="RemoveMember_Click" ToolTip="Remove from group"
                                                        IsEnabled="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType={x:Type views:ApplicationDetailView}}}">
                                                    <controls:LineIcon Data="{DynamicResource IconX}" Width="13" Height="13"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="5" Text="{Binding MembersStatus}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </controls:PageFrame>
</UserControl>
