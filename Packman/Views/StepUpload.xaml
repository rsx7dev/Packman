<UserControl x:Class="Packman.Views.StepUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <!-- Step 2 of the wizard: everything the Intune app needs. Nothing is sent from here;
         the rail beside it (WizardRail) tracks what is ready. -->
    <Border Style="{StaticResource SectionPanel}">
        <StackPanel>
            <TextBlock Text="Configure deployment" Style="{StaticResource H1}" FontSize="20"/>
            <Border Style="{StaticResource SectionRule}" Margin="0,16,0,18"/>

            <!-- ═══ Install behavior ═══ -->
            <controls:SectionHeader Title="Install behavior" Caption="How Intune installs and uninstalls the application with PSADT."/>

            <TextBlock Text="Name in Intune" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
            <TextBox AutomationProperties.Name="Name in Intune" Style="{StaticResource TextField}"
                     Text="{Binding Upload.IntuneDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- The command lines come from Settings ▸ Intune defaults; the deploy mode is appended here. -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Install command" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Install command" Style="{StaticResource MonoField}" IsReadOnly="True" FontSize="12.5"
                             Text="{Binding Upload.InstallCommandPreview, Mode=OneWay}" ToolTip="{Binding Upload.InstallCommandPreview}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Uninstall command" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Uninstall command" Style="{StaticResource MonoField}" IsReadOnly="True" FontSize="12.5"
                             Text="{Binding Upload.UninstallCommandPreview, Mode=OneWay}" ToolTip="{Binding Upload.UninstallCommandPreview}"/>
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Edit defaults in Settings" FontSize="12.5"
                        Click="OpenIntuneDefaults_Click"/>
                <TextBlock Text="Command lines come from Settings ▸ Intune defaults. The deploy mode below is appended to both."
                           Style="{StaticResource SubText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PSADT deploy mode" Style="{StaticResource FieldLabel}"/>
                    <ComboBox AutomationProperties.Name="PSADT deploy mode"
                              ItemsSource="{Binding Upload.DeployModes}"
                              SelectedItem="{Binding Upload.SelectedDeployMode, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding Upload.DeployModeHint}" Margin="0,7,0,0" TextWrapping="Wrap"
                               FontSize="12" LineHeight="17" Foreground="{DynamicResource Muted2Brush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <ContentControl Style="{StaticResource FieldRow}" Tag="Install context" Content="{Binding Upload.InstallContextText}" Margin="0,2,0,8"/>
                    <ContentControl Style="{StaticResource FieldRow}" Tag="Restart behavior" Content="{Binding Upload.RestartBehaviorText}"/>
                    <ContentControl Style="{StaticResource FieldRow}" Tag="Maximum install time" Content="{Binding Upload.MaxRunTimeText}"/>
                </StackPanel>
            </Grid>

            <!-- Upgrade only: the relationship the publish writes. -->
            <Border Style="{StaticResource Callout}" Margin="0,16,0,0"
                    Visibility="{Binding Upload.HasSupersedence, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconRefresh}" Foreground="{DynamicResource AccentTextBrush}"
                                       VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Supersedence" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Upload.SupersedenceSummary}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CalloutNeutral}" Margin="0,16,0,0"
                    Visibility="{Binding ShowNoSupersedenceNote, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                           Text="No earlier Intune app is recorded for the upgraded package, so this version publishes as a new app without supersedence."/>
            </Border>

            <Border Style="{StaticResource SectionRule}"/>

            <!-- ═══ Detection rule ═══ -->
            <controls:SectionHeader Title="Detection rule" Caption="How Intune detects that the application is installed."/>

            <TextBlock Text="Detection method" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
            <ComboBox AutomationProperties.Name="Detection method" HorizontalAlignment="Left" MinWidth="300"
                      ItemsSource="{Binding Upload.DetectionMethods}"
                      SelectedItem="{Binding Upload.SelectedDetectionMethod, Mode=TwoWay}"/>

            <!-- File exists / File version -->
            <Grid Margin="0,14,0,0" Visibility="{Binding Upload.IsFileDetection, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Folder path" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Folder path" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="%ProgramFiles%\Contoso"
                             Text="{Binding Upload.DetectionPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="File or folder name" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="File or folder name" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="app.exe"
                             Text="{Binding Upload.DetectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Visibility="{Binding Upload.IsFileVersionDetection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Minimum version" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Minimum version" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="1.2.3"
                             Text="{Binding Upload.DetectionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Registry key exists -->
            <Grid Margin="0,14,0,0" Visibility="{Binding Upload.IsRegistryDetection, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hive" Style="{StaticResource FieldLabel}"/>
                    <ComboBox AutomationProperties.Name="Hive"
                              ItemsSource="{Binding Upload.RegistryHives}"
                              SelectedItem="{Binding Upload.SelectedRegistryHive, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Key path" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Key path" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="SOFTWARE\Contoso\App"
                             Text="{Binding Upload.RegistryKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Value name (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Value name (optional)" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="blank checks the key itself"
                             Text="{Binding Upload.RegistryValueName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- MSI product code -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding Upload.IsMsiDetection, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="MSI product code"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="MSI product code" Style="{StaticResource MonoField}"
                         local:PlaceholderText.Text="{}{00000000-0000-0000-0000-000000000000}"
                         Text="{Binding Upload.DetectionProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                           Visibility="{Binding Upload.HasNoMsiProductCode, Converter={StaticResource BoolToVis}}"
                           Text="No MSI found in the package. Enter the product code manually."/>
            </StackPanel>

            <DockPanel Margin="0,12,0,0">
                <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" VerticalAlignment="Top" Padding="7,3">
                    <TextBlock Text="Rule" FontFamily="{StaticResource UIFontFamily}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
                <TextBlock Text="{Binding Upload.DetectionSummary}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{StaticResource SectionRule}"/>

            <!-- ═══ Requirements ═══ -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Restore defaults" VerticalAlignment="Top"
                        Command="{Binding Upload.RestoreDefaultsCommand}" ToolTip="Reload requirements and return codes from Settings ▸ Intune defaults"/>
                <controls:SectionHeader Title="Requirements" Caption="Devices that don't meet these are not offered the app. Pre-filled from Settings ▸ Intune defaults."/>
            </DockPanel>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Architecture follows the package (AppArch); change it on the Package step. -->
                <StackPanel>
                    <TextBlock Text="Architecture" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Architecture" Style="{StaticResource MonoField}" IsReadOnly="True"
                             Text="{Binding Upload.ArchitectureText, Mode=OneWay}" ToolTip="Set on the Package step"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Minimum Windows release" Style="{StaticResource FieldLabel}"/>
                    <ComboBox AutomationProperties.Name="Minimum Windows release"
                              ItemsSource="{Binding Upload.OperatingSystems}"
                              SelectedItem="{Binding Upload.SelectedOperatingSystem, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Disk space (MB)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Disk space (MB)" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="no minimum"
                             Text="{Binding Upload.MinFreeDiskSpaceMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Processors" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Processors" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="any"
                             Text="{Binding Upload.MinProcessors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Memory (MB)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Memory (MB)" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="no minimum"
                             Text="{Binding Upload.MinMemoryMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4">
                    <TextBlock Text="CPU speed (MHz)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="CPU speed (MHz)" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="no minimum"
                             Text="{Binding Upload.MinCpuSpeedMHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Return codes: rarely changed, so folded by default. Style="{x:Null}" is
                 load-bearing: WPF UI's implicit ToggleButton style would eat the click. -->
            <ToggleButton x:Name="ReturnCodesToggle" Style="{x:Null}" FocusVisualStyle="{StaticResource FocusVisual}"
                          AutomationProperties.Name="Return codes" Cursor="Hand" HorizontalAlignment="Left"
                          Background="Transparent" BorderThickness="0" Margin="0,20,0,0">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent" TextElement.Foreground="{DynamicResource Text2Brush}">
                            <controls:LineIcon x:Name="chev" Data="{DynamicResource IconChevR}" Width="14" Height="14"/>
                            <TextBlock Text="Return codes" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Muted2Brush}">
                                <Run Text="{Binding Upload.ReturnCodes.Count, Mode=OneWay}"/><Run Text=" mapped"/>
                            </TextBlock>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsChecked, ElementName=ReturnCodesToggle, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource MonoField}" AutomationProperties.Name="New return code"
                             local:PlaceholderText.Text="Exit code, e.g. 1707"
                             Text="{Binding Upload.NewReturnCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Add"
                            Command="{Binding Upload.AddReturnCodeCommand}"/>
                </Grid>
                <controls:ReturnCodeEditor DataContext="{Binding Upload}" Margin="0,12,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource SectionRule}"/>

            <!-- ═══ Assignments ═══ -->
            <controls:SectionHeader Title="Assignments" Caption="The Microsoft Entra groups and intent for this application. Pre-filled from Settings ▸ Group assignment."/>
            <controls:GroupPickerControl DataContext="{Binding Upload.GroupPicker}" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding Upload.PerPackageGroupsSummary}" Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Border Style="{StaticResource CalloutWarn}" Margin="0,14,0,0"
                    Visibility="{Binding Upload.IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Text="Not signed in to Intune. Sign in to search groups."/>
            </Border>

            <TextBlock Text="{Binding Upload.StatusText}" Margin="0,18,0,0" TextWrapping="Wrap"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                       Foreground="{DynamicResource Muted2Brush}"
                       Visibility="{Binding Upload.StatusText, Converter={StaticResource NonEmptyToVis}}"/>
        </StackPanel>
    </Border>
</UserControl>
