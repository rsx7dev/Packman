<UserControl x:Class="Packman.Views.Onboarding.ConnectionStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls">
    <StackPanel Margin="0,0,24,0">
        <TextBlock Text="Connect to Intune" Style="{StaticResource H1}"/>
        <TextBlock Text="Choose how Packman signs in. Test it now, or connect later: packaging works offline."
                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,18"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton GroupName="ConnectionMethod" Style="{StaticResource MethodCard}"
                         IsChecked="{Binding IsInteractive}" AutomationProperties.Name="Interactive sign-in">
                <StackPanel>
                    <TextBlock Text="Interactive sign-in" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Sign in as yourself. Your Entra role decides what you can change; no app registration needed."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" GroupName="ConnectionMethod" Style="{StaticResource MethodCard}"
                         IsChecked="{Binding IsAppRegistration}" AutomationProperties.Name="App registration">
                <StackPanel>
                    <TextBlock Text="App registration" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Sign in as an app with a certificate. Needs an app registration with admin consent for the permissions below."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- Interactive: tenant only, and optional -->
        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Tenant ID (optional)" Style="{StaticResource FieldLabel}"/>
            <TextBox AutomationProperties.Name="Tenant ID (optional)" Style="{StaticResource MonoField}"
                     Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="A tenant GUID or contoso.onmicrosoft.com. Leave it empty to use the tenant of the account you sign in with."
                       Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- App registration: tenant, client, certificate, permissions -->
        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsAppRegistration, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Tenant ID" Style="{StaticResource MonoField}"
                             Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Application (Client) ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Application (Client) ID" Style="{StaticResource MonoField}"
                             Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox AutomationProperties.Name="Certificate" ItemsSource="{Binding AvailableCertificates}"
                          SelectedItem="{Binding SelectedCert}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RefreshCertificatesCommand}" Margin="10,0,0,0"
                        AutomationProperties.Name="Refresh certificates" ToolTip="Read the certificate store again">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconRefresh}" Width="14" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0">
                <Run Text="Only certificates with a private key in"/>
                <Run Text="CurrentUser\My" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                <Run Text="are listed."/>
            </TextBlock>

            <!-- Empty, unreadable and missing-certificate states -->
            <Border Style="{StaticResource CalloutNeutral}" Margin="0,10,0,0" Visibility="{Binding NoCertificates, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconInfo}" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="13"
                               Text="No certificate with a private key was found. Import the .pfx you uploaded to the app registration (double-click it, store location Current User), then choose Refresh."/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CalloutBad}" Margin="0,10,0,0" Visibility="{Binding HasCertificateError, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Text="{Binding CertificateError}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CalloutWarn}" Margin="0,10,0,0" Visibility="{Binding SavedCertMissing, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="13"
                               Text="The certificate saved in your settings is not in this store. It stays saved until you pick another or import it and choose Refresh."/>
                </DockPanel>
            </Border>

            <TextBlock Text="Required Graph permissions" Style="{StaticResource H3}" Margin="0,22,0,0"/>
            <TextBlock Text="Add these as Application permissions on Microsoft Graph and grant admin consent."
                       Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,10"/>
            <Border Style="{StaticResource CalloutNeutral}" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Click="CopyPermissions_Click"
                            AutomationProperties.Name="Copy permissions">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconCopy}" Width="14" Height="14" Margin="0,0,7,0"/>
                            <TextBlock Text="Copy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding RequiredPermissions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Test or defer -->
        <TextBlock Text="Test the connection" Style="{StaticResource H3}" Margin="0,24,0,0"/>
        <TextBlock Text="Checks read access and the write permission publishing needs. Nothing is changed in your tenant."
                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,12"/>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Command="{Binding TestConnectionCommand}" MinWidth="160" Margin="0,0,10,0"
                    AutomationProperties.Name="Test connection">
                <StackPanel Orientation="Horizontal">
                    <controls:LineIcon Data="{DynamicResource IconRefresh}" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Test connection" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Content="Connect later" Command="{Binding ConnectLaterCommand}" MinWidth="130"/>
        </StackPanel>

        <ContentControl Content="{Binding ConnectionResult}" ContentTemplate="{StaticResource SetupCheckCallout}" Focusable="False" Margin="0,12,0,0"/>

        <ItemsControl ItemsSource="{Binding ConnectionChecks}" Margin="0,8,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:LineIcon Width="14" Height="14" Margin="0,0,10,0">
                                <controls:LineIcon.Style>
                                    <Style TargetType="controls:LineIcon" BasedOn="{StaticResource {x:Type controls:LineIcon}}">
                                        <Setter Property="Data" Value="{DynamicResource IconAlert}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter Property="Data" Value="{DynamicResource IconCheck}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:LineIcon.Style>
                            </controls:LineIcon>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Margin="16,0,0,0" FontSize="12.5" Foreground="{DynamicResource Muted2Brush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Connect later: packaging works offline. Upload, Applications and other Intune pages ask you to sign in until you connect in Settings."/>
    </StackPanel>
</UserControl>
