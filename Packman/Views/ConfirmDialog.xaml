<Window x:Class="Packman.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FlyoutBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UIFontFamily}" FontSize="13.5"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}">
    <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="24,22,24,20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="ActionButton" Style="{StaticResource DangerButton}" Click="Action_Click"/>
                <Button x:Name="SecondButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Second_Click"/>
                <Button x:Name="SafeButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        IsDefault="True" IsCancel="True" Click="Safe_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
