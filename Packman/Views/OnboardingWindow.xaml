<ui:FluentWindow x:Class="Packman.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Packman"
        xmlns:controls="clr-namespace:Packman.Views.Controls"
        Title="Packman — Set up"
        Width="760" Height="440"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        FontSize="13.5"
        Background="{DynamicResource ShellBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!-- Setup is a single sheet with a single question: no navigation, nowhere else to go until it
         is answered. Same chrome as the main window: title bar with the brand mark, PageFrame,
         activity dock above the footer action. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Height="44" Padding="12,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Margin="4,0,0,0" Background="{DynamicResource PrimaryBrush}">
                        <Rectangle Width="6" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource PrimaryFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Packman" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <Border Margin="12,0,0,0" Padding="12,0,0,0" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,0,0,0">
                        <TextBlock Text="Set up" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <controls:PageFrame Grid.Row="1" Title="Welcome to Packman" Subtitle="Choose where your packages are saved." IsBodyScrollable="False">
            <controls:PageFrame.Footer>
                <StackPanel>
                    <controls:ActivityDock Margin="0,0,0,12" JobName="Setup" IsIndeterminate="True"
                                           IsActive="{Binding IsBusy}" Phase="Checking the folder…"
                                           CancelCommand="{Binding CancelCommand}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="The PSADT v4 template is included; IntuneWinAppUtil is downloaded from Microsoft on your first publish."
                                   Style="{StaticResource FooterHint}" Margin="0,0,18,0"/>
                        <Button Grid.Column="1" Command="{Binding NextCommand}" IsDefault="True" MinWidth="160" Style="{StaticResource PrimaryButton}"
                                AutomationProperties.Name="Get started">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Get started" VerticalAlignment="Center"/>
                                <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </controls:PageFrame.Footer>

            <StackPanel Margin="0,0,24,0" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Packages folder" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RootBox" AutomationProperties.Name="Packages folder" Style="{StaticResource TextField}"
                             Text="{Binding ApplicationsRoot, UpdateSourceTrigger=PropertyChanged}"
                             local:PlaceholderText.Text="\\server\share\IntuneApps"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="Browse_Click" Margin="10,0,0,0"
                            AutomationProperties.Name="Browse for the packages folder">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconFolder}" Width="14" Height="14" Margin="0,0,7,0"/>
                            <TextBlock Text="Browse" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="Packman creates every package here. A network share or a local folder works."
                           Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ContentControl Content="{Binding ApplicationsRootCheck}" ContentTemplate="{StaticResource SetupCheckCallout}" Focusable="False" Margin="0,8,0,0">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApplicationsRootCheck}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </controls:PageFrame>
    </Grid>
</ui:FluentWindow>
