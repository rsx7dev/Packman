<ui:FluentWindow x:Class="Packman.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Packman.Views.Controls"
        xmlns:onboarding="clr-namespace:Packman.Views.Onboarding"
        Title="Packman — Set up"
        Width="1080" Height="720"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        FontSize="13.5"
        Background="{DynamicResource ShellBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!-- Setup is a single sheet: no navigation, nowhere else to go until it is done.
         Same chrome as the main window: title bar with the brand mark, PageFrame, stepper,
         activity dock above the footer actions. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Height="44" Padding="12,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Margin="4,0,0,0" Background="{DynamicResource PrimaryBrush}">
                        <Rectangle Width="6" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource PrimaryFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Packman" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <Border Margin="12,0,0,0" Padding="12,0,0,0" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,0,0,0">
                        <TextBlock Text="Set up" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <controls:PageFrame Grid.Row="1" Title="Set up Packman" Subtitle="{Binding StepCaption}" IsBodyScrollable="False">
            <controls:PageFrame.HeaderBottom>
                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepperItem}" Margin="0,14" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </controls:PageFrame.HeaderBottom>

            <controls:PageFrame.Footer>
                <StackPanel>
                    <controls:ActivityDock Margin="0,0,0,12" JobName="Setup" IsIndeterminate="True"
                                           IsActive="{Binding IsBusy}" Phase="{Binding BusyText}"
                                           CancelCommand="{Binding CancelCommand}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BackButton}" Command="{Binding BackCommand}" MinWidth="104">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding StepHint}" Style="{StaticResource FooterHint}" Margin="18,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button Grid.Column="2" Command="{Binding NextCommand}" IsDefault="True" MinWidth="160" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NextLabel}" VerticalAlignment="Center"/>
                                <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </controls:PageFrame.Footer>

            <!-- Rail: what is set so far. -->
            <controls:PageFrame.Rail>
                <StackPanel>
                    <TextBlock Text="Your setup" Style="{StaticResource RailTitle}" Margin="0,0,0,6"/>
                    <controls:StatusRow Label="Connection" Value="{Binding RailConnection}" Kind="{Binding RailConnectionKind}"/>
                    <controls:StatusRow Label="Paths" Value="{Binding RailPaths}" Kind="{Binding RailPathsKind}"/>
                    <controls:StatusRow Label="Package folders" Value="{Binding RailLayout}" Kind="ok"/>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="Nothing is saved until you press Finish. Run setup again any time from Settings."/>
                </StackPanel>
            </controls:PageFrame.Rail>

            <Grid>
                <!-- Welcome -->
                <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,24,0" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Welcome to Packman" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"
                                   Text="Packman turns an installer into a PSADT v4 package on your share and publishes it to Intune as a Win32 app. Setup asks how to connect to Intune, where your packages and tools live, and which folders each new package gets."/>
                        <Border Style="{StaticResource SectionRule}" Margin="0,22"/>
                        <TextBlock Text="You will need" Style="{StaticResource H3}"/>
                        <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="A folder for your packages, the PSADT v4 template, and IntuneWinAppUtil.exe. To connect with an app registration you also need its Tenant ID, Client ID and a certificate installed for your user."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ConnectionPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <onboarding:ConnectionStep/>
                </ScrollViewer>

                <ScrollViewer x:Name="PathsPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <onboarding:PathsStep/>
                </ScrollViewer>

                <!-- Package layout: the same editor the Settings tab uses. -->
                <ScrollViewer x:Name="LayoutPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Steps[3].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Package folders" Style="{StaticResource H1}"/>
                        <TextBlock Text="Choose the folders each new package gets. This only applies to new packages; existing ones are never changed."
                                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <controls:PackageLayoutEditor DataContext="{Binding Layout}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Summary -->
                <ScrollViewer x:Name="SummaryPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Steps[4].IsCurrent, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Review and finish" Style="{StaticResource H1}"/>
                        <TextBlock Text="Finish saves these settings on this PC and opens Packman. Code signing, groups and Intune defaults stay as they are."
                                   Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <ItemsControl ItemsSource="{Binding SummaryRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="13"/>
                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Change" Margin="16,0,0,0" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding StepIndex}"
                                                    AutomationProperties.Name="{Binding Label, StringFormat='Change {0}'}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource CalloutBad}" Margin="0,16,0,0" Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:PageFrame>
    </Grid>
</ui:FluentWindow>
