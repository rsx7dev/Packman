<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Packman" xmlns:controls="clr-namespace:Packman.Views.Controls" x:Class="Packman.Views.Controls.AppearanceSettings">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <StackPanel>
            <!-- Card header -->
            <controls:SectionHeader Title="Appearance" Caption="How Packman looks on this machine." Margin="0,0,0,20"/>
            <!-- Theme (System | Dark | Light) -->
            <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource SegmentGroup}" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ModeToggle}" Content="System" IsChecked="{Binding IsThemeSystem}"/>
                    <RadioButton Style="{StaticResource ModeToggle}" Content="Dark" IsChecked="{Binding IsThemeDark}"/>
                    <RadioButton Style="{StaticResource ModeToggle}" Content="Light" IsChecked="{Binding IsThemeLight}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Applies immediately and is saved automatically. System follows your Windows appearance setting." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>
