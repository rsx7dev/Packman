<UserControl x:Class="Packman.Views.Controls.PublishStepList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PublishRunViewModel}">
    <!-- DataContext is a PublishRunViewModel: one row per step with its state. -->
    <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Padding="0,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- status mark -->
                        <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                            <Border CornerRadius="11" Background="{DynamicResource OkSoftBrush}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="12" Height="12">
                                    <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.8" Style="{StaticResource Icon}"/>
                                </Viewbox>
                            </Border>
                            <Border CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentTextBrush}"/>
                            </Border>
                            <Border CornerRadius="11" Background="{DynamicResource BadSoftBrush}" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="11" Height="11">
                                    <Path Data="{StaticResource IconX}" Stroke="{DynamicResource BadBrush}" StrokeThickness="2.4" Style="{StaticResource Icon}"/>
                                </Viewbox>
                            </Border>
                            <Border CornerRadius="11" Background="{DynamicResource Card2Brush}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPending}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
