<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Packman" xmlns:controls="clr-namespace:Packman.Views.Controls" x:Class="Packman.Views.Controls.NetworkPathsSettings">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <StackPanel>
            <!-- ═══ Packages and tools ═══ -->
            <controls:SectionHeader Title="Paths" Caption="Where packages are written. The PSADT template and IntuneWinAppUtil come bundled with Packman; set a path only to use your own." Margin="0,0,0,20"/>
            <!-- Intune Applications output path -->
            <TextBlock Text="Intune Applications Path" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,7,0,0">
                <TextBox AutomationProperties.Name="Intune Applications Path" Style="{StaticResource TextField}" Text="{Binding IntuneApplicationsPath, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="\\server\share\IntuneApps"/>
            </Grid>
            <!-- PSADT Template path -->
            <TextBlock Text="PSADT Template Path" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
            <Grid Margin="0,7,0,0">
                <TextBox AutomationProperties.Name="PSADT Template Path" Style="{StaticResource TextField}" Text="{Binding PSADTTemplatePath, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="Bundled PSADT v4 template"/>
            </Grid>
            <!-- IntuneWinAppUtil path -->
            <TextBlock Text="IntuneWinAppUtil Path" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
            <Grid Margin="0,7,0,0">
                <TextBox AutomationProperties.Name="IntuneWinAppUtil Path" Style="{StaticResource TextField}" Text="{Binding IntuneWinAppUtilPath, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="Bundled IntuneWinAppUtil.exe"/>
            </Grid>
            <!-- PSADT log folder: PSADT decides it, so it is shown, not set. -->
            <TextBlock Text="PSADT Log Folder" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
            <TextBox AutomationProperties.Name="PSADT Log Folder" Style="{StaticResource MonoField}" Margin="0,7,0,0" IsReadOnly="True"
                     Text="{Binding PsadtLogFolder, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Read from LogPath in the template's Config\config.psd1. Change it there; suggested /log switches follow it."/>

            <!-- ═══ Remote test ═══ -->
            <Border Style="{StaticResource SectionRule}" Margin="0,24"/>
            <controls:SectionHeader Title="Remote test" Caption="Where packages are copied on the test computer before they run." Margin="0,0,0,20"/>
            <TextBlock Text="Staging Folder on Target" Style="{StaticResource FieldLabel}"/>
            <TextBox AutomationProperties.Name="Remote test staging folder on target" Style="{StaticResource MonoField}" Margin="0,7,0,0"
                     Text="{Binding RemoteStagingFolder, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="C:\ProgramData"/>
            <TextBlock Text="{Binding RemoteStagingPreview}" Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasRemoteStagingProblem, Converter={StaticResource InverseBoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding HasRemoteStagingProblem, Converter={StaticResource BoolToVis}}">
                <controls:LineIcon Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding RemoteStagingProblem}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="A local folder on the target. Packman always works in its own Packman subfolder there and limits it to SYSTEM and Administrators."/>

            <!-- ═══ Logs ═══ -->
            <Border Style="{StaticResource SectionRule}" Margin="0,24"/>
            <controls:SectionHeader Title="Logs" Caption="Every upload and content update writes a log. Point this at a share to keep a team audit trail." Margin="0,0,0,20"/>
            <TextBlock Text="Upload Logs Folder" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.Name="Upload logs folder" Style="{StaticResource TextField}"
                         Text="{Binding UploadLogsFolder, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="%LocalAppData%\Packman\Logs"/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Open logs folder"
                        Command="{Binding OpenLogsFolderCommand}"/>
            </Grid>
            <TextBlock Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Empty keeps logs on this computer. If the folder can't be written during a publish, the log goes to the local folder and the console says so."/>
        </StackPanel>
    </Border>
</UserControl>
