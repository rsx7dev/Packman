<ui:FluentWindow x:Class="Packman.Views.Controls.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Packman.Views.Controls"
        Title="Packman — Console"
        Width="720" Height="520" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        FontSize="13.5"
        Background="{DynamicResource ShellBrush}"
        Foreground="{DynamicResource TextBrush}">
    <!-- The console on its own, e.g. on a second screen during a remote test. Same lines,
         height-free; closing it docks the console back into the rails. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Height="40" Padding="12,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Margin="4,0,0,0" Background="{DynamicResource PrimaryBrush}">
                        <Rectangle Width="6" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource PrimaryFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Packman" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <Border Margin="12,0,0,0" Padding="12,0,0,0" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,0,0,0">
                        <TextBlock Text="Console" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <Border Grid.Row="1" Margin="12,0,12,12" Padding="20,16,20,20" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
            <controls:ActivityConsole IsDetached="True"/>
        </Border>
    </Grid>
</ui:FluentWindow>
