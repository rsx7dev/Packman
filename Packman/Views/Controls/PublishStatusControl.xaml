<UserControl x:Class="Packman.Views.Controls.PublishStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Packman"
    xmlns:controls="clr-namespace:Packman.Views.Controls"
    >
    <Border Style="{StaticResource Card}" Padding="22,20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
            <!-- While it runs, the activity dock in the page footer carries the status, progress and Cancel. -->
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>
            <controls:PublishStepList Margin="0,14,0,0"/>
            <!-- Result: neutral until the run ends with warnings (amber) or fails (red). -->
            <Border Margin="0,18,0,0" Visibility="{Binding ResultText, Converter={StaticResource NonEmptyToVis}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CalloutNeutral}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource WarnLineBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BadSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BadLineBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Button Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Left" Margin="0,18,0,0"
                Command="{Binding DoneCommand}" Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Border>
</UserControl>
