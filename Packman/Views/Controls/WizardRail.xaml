<UserControl x:Class="Packman.Views.Controls.WizardRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:local="clr-namespace:Packman"
             xmlns:services="clr-namespace:Packman.Services"
             FontFamily="{StaticResource UIFontFamily}">
    <!-- Inspector beside the Create wizard, one panel per step. DataContext: MainViewModel.
         It shows what the form beside it doesn't: where the package lands, what was read
         from the installer, and what still stands between this package and Intune. -->
    <UserControl.Resources>
        <!-- One Property-table row: name over value, with an Add button for public properties. -->
        <DataTemplate x:Key="MsiPropertyRow">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Add" Margin="12,0,0,0" VerticalAlignment="Top"
                            Visibility="{Binding IsPublic, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.CreatePackage.AddMsiPropertyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Argument}"
                            AutomationProperties.Name="{Binding Argument, StringFormat='Add {0} to the install command'}"
                            ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One silent switch: the text and its one-line explanation, with an Add button. The
             install and uninstall lists differ only in the command they feed. -->
        <DataTemplate x:Key="InstallSwitchRow">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource SubText}" FontSize="12" LineHeight="17"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Add" Margin="12,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DataContext.CreatePackage.AddInstallSwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Text}"
                            AutomationProperties.Name="{Binding Text, StringFormat='Add {0} to the install command'}"
                            ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="UninstallSwitchRow">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource SubText}" FontSize="12" LineHeight="17"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Add" Margin="12,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DataContext.CreatePackage.AddUninstallSwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Text}"
                            AutomationProperties.Name="{Binding Text, StringFormat='Add {0} to the uninstall command'}"
                            ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ Step 1: Package preview ═══ -->
        <StackPanel Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Package preview" Style="{StaticResource RailTitle}"/>

            <!-- Create new -->
            <StackPanel Visibility="{Binding IsUpgradeMode, Converter={StaticResource InverseBoolToVis}}">
                <controls:AppIdentity Margin="0,18,0,8"
                                      Title="{Binding CreatePackage.PreviewTitle}"
                                      Subtitle="{Binding CreatePackage.Manufacturer}"
                                      Meta="{Binding CreatePackage.PreviewMeta}"
                                      IconPath="{Binding CreatePackage.ExtractedIconPath}"/>
                <ContentControl Style="{StaticResource KvRow}" Tag="Type" Content="PSADT v4 · Win32"/>
                <ContentControl Style="{StaticResource KvRow}" Tag="Installer" Content="{Binding CreatePackage.InstallerType}"/>
                <ContentControl Style="{StaticResource KvRowMono}" Tag="Product code" Content="{Binding CreatePackage.ProductCode}"
                                Visibility="{Binding CreatePackage.HasProductCode, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Style="{StaticResource KvRowMono}" Tag="Package folder" Content="{Binding PackageFolderPreview}"/>
            </StackPanel>

            <!-- Upgrade existing -->
            <StackPanel Visibility="{Binding IsUpgradeMode, Converter={StaticResource BoolToVis}}">
                <controls:AppIdentity Margin="0,18,0,8"
                                      Title="{Binding Upgrade.PackageDisplayName}"
                                      Subtitle="{Binding Upgrade.PackageDisplayContext}"
                                      Meta="{Binding Upgrade.PackageDisplayVersion}"/>
                <ContentControl Style="{StaticResource KvRow}" Tag="Type" Content="PSADT v4 · Win32 upgrade"/>
                <ContentControl Style="{StaticResource KvRowMono}" Tag="New version" Content="{Binding Upgrade.NewVersion}"/>
                <ContentControl Style="{StaticResource KvRowMono}" Tag="Existing package" Content="{Binding Upgrade.ExistingPackagePath}"/>
                <TextBlock Text="The script, Files and edits carry over. Only the named installer is replaced."
                           Style="{StaticResource SubText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- The only place a missing output share or template shows before generating. -->
            <StackPanel Margin="0,18,0,0">
                <DockPanel Margin="0,0,0,6"
                            Visibility="{Binding OutputShareReady, Converter={StaticResource InverseBoolToVis}}">
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Text="Output share not set. Set it in Settings." TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,6"
                            Visibility="{Binding TemplateReady, Converter={StaticResource InverseBoolToVis}}">
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Text="PSADT template not set. Set it in Settings." TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                </DockPanel>
            </StackPanel>

            <!-- EXE only: the generated script cannot know the vendor's silent switches. -->
            <Border Style="{StaticResource CalloutWarn}" Margin="0,14,0,0"
                    Visibility="{Binding CreatePackage.IsExeInstaller, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}"
                                       VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                               Text="EXE installers need their real silent switches. Add them from the installer type below, or set them in Edit script before you test."/>
                </DockPanel>
            </Border>

            <!-- Installer insight: what a static read of the picked EXE or MSI found. -->
            <StackPanel Visibility="{Binding IsUpgradeMode, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Reading installer…" Style="{StaticResource SubText}" Margin="0,20,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding CreatePackage.IsReadingInstaller, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Visibility="{Binding CreatePackage.IsReadingInstaller, Converter={StaticResource InverseBoolToVis}}">
                    <Border Style="{StaticResource CalloutWarn}" Margin="0,20,0,0"
                            Visibility="{Binding CreatePackage.HasInstallerError, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}"
                                               VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" AutomationProperties.LiveSetting="Polite"
                                       Text="{Binding CreatePackage.InstallerError}"/>
                        </DockPanel>
                    </Border>

                    <!-- EXE -->
                    <StackPanel Visibility="{Binding CreatePackage.HasExeInsight, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Installer type" Style="{StaticResource H3}" Margin="0,26,0,2"/>
                        <ContentControl Style="{StaticResource KvRow}" Tag="Detected" Content="{Binding CreatePackage.InstallerKindName}"/>
                        <ContentControl Style="{StaticResource KvRow}" Tag="Confidence" Content="{Binding CreatePackage.InstallerConfidence}"
                                        Visibility="{Binding CreatePackage.HasDetectedInstaller, Converter={StaticResource BoolToVis}}"/>
                        <ContentControl Style="{StaticResource KvRowMono}" Tag="Found in" Content="{Binding CreatePackage.InstallerEvidence}"
                                        Visibility="{Binding CreatePackage.HasDetectedInstaller, Converter={StaticResource BoolToVis}}"/>

                        <Border Style="{StaticResource CalloutWarn}" Margin="0,12,0,0"
                                Visibility="{Binding CreatePackage.IsUnknownInstaller, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}"
                                                   VerticalAlignment="Top" Margin="0,1,10,0"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                           Text="Installer type not recognised. These are common switches, untested."/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding CreatePackage.InstallerNote}" Style="{StaticResource SubText}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding CreatePackage.HasInstallerNote, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="This installer has no silent switches to add." Style="{StaticResource SubText}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding CreatePackage.HasNoSwitches, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding CreatePackage.HasNoSwitches, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="Install switches" Style="{StaticResource H3}" Margin="0,18,0,2"/>
                            <ItemsControl ItemsSource="{Binding CreatePackage.InstallSwitches}"
                                          ItemTemplate="{StaticResource InstallSwitchRow}" IsTabStop="False"/>
                            <TextBlock Text="Uninstall switches" Style="{StaticResource H3}" Margin="0,18,0,2"/>
                            <ItemsControl ItemsSource="{Binding CreatePackage.UninstallSwitches}"
                                          ItemTemplate="{StaticResource UninstallSwitchRow}" IsTabStop="False"/>

                            <ContentControl Style="{StaticResource KvRowMono}" Tag="Uninstaller" Content="{Binding CreatePackage.InstallerLocation}"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding CreatePackage.HasInstallerLocation, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="The uninstall line runs the setup file. Point it at this uninstaller in Edit script."
                                       Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding CreatePackage.HasInstallerLocation, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- MSI -->
                    <StackPanel Visibility="{Binding CreatePackage.HasMsiInsight, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="MSI properties" Style="{StaticResource H3}" Margin="0,26,0,2"/>
                        <ItemsControl ItemsSource="{Binding CreatePackage.MsiKeyProperties}"
                                      ItemTemplate="{StaticResource MsiPropertyRow}" IsTabStop="False"/>

                        <StackPanel Visibility="{Binding CreatePackage.HasMsiTransforms, Converter={StaticResource BoolToVis}}">
                            <ContentControl Style="{StaticResource KvRowMono}" Tag="Transforms" Content="{Binding CreatePackage.MsiTransformNames}"
                                            Margin="0,8,0,0"/>
                            <TextBlock Text="Packman copies only the MSI. Add the .mst to Files and use -Transforms in Edit script."
                                       Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Text="All properties" Style="{StaticResource H3}" Margin="0,22,0,8"/>
                        <Grid>
                            <TextBox Style="{StaticResource TextField}" Padding="38,0,11,0" AutomationProperties.Name="Search MSI properties"
                                     Background="{DynamicResource Card2Brush}" BorderBrush="Transparent"
                                     local:PlaceholderText.Text="Search MSI properties"
                                     Text="{Binding CreatePackage.MsiSearch, UpdateSourceTrigger=PropertyChanged}"/>
                            <controls:LineIcon Data="{DynamicResource IconSearch}" HorizontalAlignment="Left" Margin="13,0,0,0"
                                               Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock Text="{Binding CreatePackage.MsiCountText}" Style="{StaticResource SubText}" FontSize="12.5"
                                   Margin="0,8,0,2" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding CreatePackage.HasMsiMatches, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding CreatePackage.MsiNoMatchText}" Style="{StaticResource SubText}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,8,0,2" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding CreatePackage.HasNoMsiMatches, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding CreatePackage.MsiProperties}"
                                      ItemTemplate="{StaticResource MsiPropertyRow}" IsTabStop="False"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ═══ Step 2: Deployment preview ═══ -->
        <StackPanel Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Deployment preview" Style="{StaticResource RailTitle}"/>
            <controls:AppIdentity Margin="0,18,0,8"
                                  Title="{Binding CreatePackage.PreviewTitle}"
                                  Subtitle="{Binding CreatePackage.Manufacturer}"
                                  Meta="{Binding CreatePackage.PreviewMeta}"
                                  IconPath="{Binding CreatePackage.ExtractedIconPath}"/>
            <ContentControl Style="{StaticResource KvRow}" Tag="Type" Content="PSADT v4 · Win32"/>
            <ContentControl Style="{StaticResource KvRow}" Tag="Detection" Content="{Binding Upload.DetectionMethodLabel}"/>
            <ContentControl Style="{StaticResource KvRow}" Tag="Deploy mode" Content="{Binding Upload.SelectedDeployMode}"/>
            <ContentControl Style="{StaticResource KvRow}" Tag="Supersedes" Content="{Binding CreatePackage.PredecessorAppId}"
                            Visibility="{Binding Upload.HasSupersedence, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- ═══ Step 3: Publish readiness, then publish progress ═══ -->
        <StackPanel Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}">
            <!-- Readiness until the publish starts; then the progress and console take its place. -->
            <StackPanel Visibility="{Binding Upload.Publish.IsNotPublishing, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Publish readiness" Style="{StaticResource RailTitle}" Margin="0,0,0,8"/>
                <controls:StatusRow Label="Package" Value="{Binding HasPackage, Converter={StaticResource BoolToText}, ConverterParameter='Ready|Not generated'}"
                                    Kind="{Binding HasPackage, Converter={StaticResource BoolToText}, ConverterParameter='ok|bad'}"/>
                <controls:StatusRow Label="Commands" Value="{Binding Upload.CommandsState}"
                                    Kind="{Binding Upload.CommandsReady, Converter={StaticResource BoolToText}, ConverterParameter='ok|warn'}"/>
                <controls:StatusRow Label="Detection" Value="{Binding Upload.DetectionState}" Detail="{Binding Upload.DetectionIssue}"
                                    Kind="{Binding Upload.DetectionReady, Converter={StaticResource BoolToText}, ConverterParameter='ok|warn'}"/>
                <controls:StatusRow Label="Assignment" Value="{Binding Upload.AssignmentState}" Detail="{Binding Upload.AssignmentDetail}"
                                    Kind="{Binding Upload.HasAssignment, Converter={StaticResource BoolToText}, ConverterParameter='ok|info'}"/>
                <controls:StatusRow Label="Intune connection" Value="{Binding ConnectionLabel}"
                                    Kind="{Binding IsConnected, Converter={StaticResource BoolToText}, ConverterParameter='ok|pending'}"/>

                <ContentControl Style="{StaticResource KvRow}" Tag="Tenant" Margin="0,12,0,0">
                    <ContentControl.Content>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Right"
                                   Text="{Binding TenantName, FallbackValue='Not signed in', TargetNullValue='Not signed in'}"/>
                    </ContentControl.Content>
                </ContentControl>

                <!-- Publishing needs a tenant. App registration connects on its own when the
                     publish starts, so the callout only shows for interactive sign-in. -->
                <Border Style="{StaticResource Callout}" Margin="0,20,0,0"
                        Visibility="{Binding Upload.ShowSignInCallout, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconInfo}" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                       Text="Connect to Microsoft Intune to publish this package and create the assignment."/>
                            <Button Style="{StaticResource LinkButton}" Content="Sign in" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{x:Static services:AppNavigation.OpenSettings}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            <controls:PublishRailPanel DataContext="{Binding Upload.Publish}"
                                       Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
