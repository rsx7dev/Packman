<UserControl x:Class="Packman.Views.Controls.PublishConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls">
    <!-- DataContext is a PublishRunViewModel: its Log as timestamped monospace lines that
         follow the newest one until the owner scrolls up. -->
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="Copy_Click" AutomationProperties.Name="Copy console">
                <StackPanel Orientation="Horizontal">
                    <controls:LineIcon Data="{DynamicResource IconCopy}" Width="14" Height="14"/>
                    <TextBlock Text="Copy" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Console" Style="{StaticResource H3}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Margin="0,8,0,0" Height="240" Background="{DynamicResource Card2Brush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" ScrollChanged="Scroller_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Log}" Margin="10,8" Focusable="False" AutomationProperties.Name="Publish console">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Section">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style><Run Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/><Run Text="{Binding Text, StringFormat='  {0}', Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
