<UserControl x:Class="Packman.Views.Controls.PublishRailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls">
    <!-- Publish progress in the wizard's rail while a publish runs or has just finished.
         DataContext is a PublishRunViewModel; the review stays in the main column. -->
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource RailTitle}"/>
        <!-- Once the run ends, the result below says it. -->
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
        <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                     AutomationProperties.Name="Publish progress"/>
        <controls:PublishStepList Margin="0,8,0,0"/>

        <!-- Result: neutral until the run ends with warnings (amber) or fails (red). -->
        <Border Margin="0,14,0,0" Visibility="{Binding ResultText, Converter={StaticResource NonEmptyToVis}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CalloutNeutral}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource WarnLineBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BadSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BadLineBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Left" Margin="0,14,0,0"
                Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel publishing"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
        <Button Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Left" Margin="0,14,0,0"
                Command="{Binding DoneCommand}" Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}"/>

        <controls:PublishConsole Margin="0,22,0,0"/>
    </StackPanel>
</UserControl>
