<UserControl x:Class="Packman.Views.Controls.PackageLayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- ── Choices ───────────────────────────────────────────── -->
        <StackPanel>
            <TextBlock Text="Every new package gets" Style="{StaticResource H3}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:LineIcon Data="{DynamicResource IconFolder}" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Application" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="PSADT files and the installer. Only this folder is packed into the .intunewin."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:LineIcon Data="{DynamicResource IconFolder}" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Intune" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="The built .intunewin and packman.id, the link to the Intune app."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <CheckBox IsChecked="{Binding IconFolder}" AutomationProperties.Name="Icon folder">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Icon" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Keep the app icon in Icon. Off: the icon is extracted for the upload and not kept."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>

            <Border Style="{StaticResource SectionRule}" Margin="0,20"/>

            <TextBlock Text="Extra folders" Style="{StaticResource H3}"/>
            <TextBlock Text="Created empty in every new package, next to Application and Intune. Not packed into the .intunewin. Upgrades copy their contents forward."
                       Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,12"/>

            <TextBlock Text="Folder name" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.Name="New extra folder name" Style="{StaticResource TextField}"
                         Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddFolderCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding AddFolderCommand}" Margin="10,0,0,0" MinWidth="84"
                        AutomationProperties.Name="Add extra folder">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconPlus}" Width="13" Height="13" Margin="0,0,7,0"/>
                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding HasFolderProblem, Converter={StaticResource BoolToVis}}">
                <controls:LineIcon Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FolderProblem}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ExtraFolders}" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove folder"
                                        AutomationProperties.Name="{Binding StringFormat='Remove {0}'}">
                                    <controls:LineIcon Data="{DynamicResource IconTrash}" Width="14" Height="14"/>
                                </Button>
                                <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconFolder}" Foreground="{DynamicResource Muted2Brush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No extra folders. New packages get only the folders above." Margin="0,10,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasExtraFolders}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- ── Example package ───────────────────────────────────── -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Example package" Style="{StaticResource H3}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CalloutNeutral}" Padding="14,12" AutomationProperties.Name="Example package folder tree"
                    AutomationProperties.LiveSetting="Polite">
                <ItemsControl ItemsSource="{Binding TreeLines}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Border Width="{Binding Indent}"/>
                                <controls:LineIcon Width="14" Height="14" Margin="0,0,7,0">
                                    <controls:LineIcon.Style>
                                        <Style TargetType="controls:LineIcon" BasedOn="{StaticResource {x:Type controls:LineIcon}}">
                                            <Setter Property="Data" Value="{DynamicResource IconFile}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter Property="Data" Value="{DynamicResource IconFolder}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:LineIcon.Style>
                                </controls:LineIcon>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Note}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted2Brush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="Sample names. Real packages use the app's own name and version." Style="{StaticResource SubText}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
