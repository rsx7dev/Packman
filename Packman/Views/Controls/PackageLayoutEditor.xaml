<UserControl x:Class="Packman.Views.Controls.PackageLayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Packman"
             xmlns:controls="clr-namespace:Packman.Views.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ── Choices ───────────────────────────────────────────── -->
        <StackPanel>
            <!-- Package folder name: where a new package lands under the Intune Applications Path. -->
            <TextBlock Text="Package folder name" Style="{StaticResource H3}"/>
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,12"
                       Text="How each new package's folder is named under the Intune Applications Path. The version is always its own subfolder."/>
            <TextBox AutomationProperties.Name="Package folder name format" Style="{StaticResource MonoField}"
                     Text="{Binding FolderNameTemplate, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="%vendor%_%appName%"/>
            <TextBlock Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Tokens: %vendor% and %appName%. Use one \ for a vendor folder. Spaces become underscores."/>
            <TextBlock Text="{Binding FolderNamePreview}" Style="{StaticResource SubText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasFolderNameProblem, Converter={StaticResource InverseBoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding HasFolderNameProblem, Converter={StaticResource BoolToVis}}">
                <controls:LineIcon Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FolderNameProblem}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="380"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Use:" Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ItemsControl ItemsSource="{Binding FolderNamePresets}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Margin="0,0,14,0" FontSize="12.5" FontFamily="{StaticResource MonoFontFamily}"
                                    Command="{Binding DataContext.UseFolderNamePresetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" Content="{Binding}"
                                    AutomationProperties.Name="{Binding StringFormat='Use the format {0}'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Style="{StaticResource SectionRule}" Margin="0,20"/>

            <!-- Application and Intune are fixed and shown in the example tree; only the choices live here. -->
            <CheckBox IsChecked="{Binding IconFolder}" AutomationProperties.Name="Icon folder" Margin="-11,0,0,0">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Icon folder" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="Keeps the app icon in the package, in Icon. When off, the icon is still extracted for the upload but not kept."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>

            <Border Style="{StaticResource SectionRule}" Margin="0,20"/>

            <TextBlock Text="Extra folders" Style="{StaticResource H3}"/>
            <TextBlock Text="Created empty in every new package, next to Application and Intune. Not packed into the .intunewin. Upgrades copy their contents forward."
                       Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,3,0,12"/>

            <TextBlock Text="Folder name" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.Name="New extra folder name" Style="{StaticResource TextField}"
                         Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="e.g. Documentation">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddFolderCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding AddFolderCommand}" Margin="10,0,0,0" MinWidth="84"
                        AutomationProperties.Name="Add extra folder">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconPlus}" Width="13" Height="13" Margin="0,0,7,0"/>
                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding HasFolderProblem, Converter={StaticResource BoolToVis}}">
                <controls:LineIcon Data="{DynamicResource IconAlert}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FolderProblem}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ExtraFolders}" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove folder"
                                        AutomationProperties.Name="{Binding StringFormat='Remove {0}'}">
                                    <controls:LineIcon Data="{DynamicResource IconTrash}" Width="14" Height="14"/>
                                </Button>
                                <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconFolder}" Foreground="{DynamicResource Muted2Brush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Common names, one click each; a name already added drops out. -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Common:" Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Margin="0,0,14,0" FontSize="12.5"
                                    Command="{Binding DataContext.AddSuggestionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" Content="{Binding}" ContentStringFormat="+ {0}"
                                    AutomationProperties.Name="{Binding StringFormat='Add {0} folder'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- ── Example package ───────────────────────────────────── -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Example package" Style="{StaticResource H3}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CalloutNeutral}" Padding="14,12" AutomationProperties.Name="Example package folder tree"
                    AutomationProperties.LiveSetting="Polite">
                <ItemsControl ItemsSource="{Binding TreeLines}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Border Width="{Binding Indent}"/>
                                <controls:LineIcon Width="14" Height="14" Margin="0,0,7,0">
                                    <controls:LineIcon.Style>
                                        <Style TargetType="controls:LineIcon" BasedOn="{StaticResource {x:Type controls:LineIcon}}">
                                            <Setter Property="Data" Value="{DynamicResource IconFile}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter Property="Data" Value="{DynamicResource IconFolder}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:LineIcon.Style>
                                </controls:LineIcon>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Note}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted2Brush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Only Application is packed into the .intunewin. Sample names: real packages use the app's vendor, name and version."/>
        </StackPanel>
    </Grid>
</UserControl>
