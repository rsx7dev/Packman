<UserControl x:Class="Packman.Views.Controls.ActivityConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls">
    <!-- The live console: what package creation, remote test, upload and update are doing, as
         timestamped monospace lines that follow the newest one until the owner scrolls up.
         Docked at the bottom of a rail it can be resized from its top edge, collapsed to its
         header, filtered to warnings and errors, or popped out into its own window (IsDetached).
         Height, filter and place are shared through ConsoleState. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Resize grip: drag the console's top edge. -->
        <Thumb x:Name="Grip" Height="12" Margin="0,-12,0,0" Cursor="SizeNS" DragDelta="Grip_DragDelta"
               ToolTip="Drag to resize the console" AutomationProperties.Name="Resize console">
            <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent">
                        <Border x:Name="pill" Width="36" Height="4" CornerRadius="2" Background="{DynamicResource EdgeBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter TargetName="pill" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Header: title with counts on the left, actions on the right. -->
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FilterButton" Style="{StaticResource LinkButton}" Click="Filter_Click"
                        ToolTip="Show only warnings and errors, or every line"/>
                <Button Style="{StaticResource LinkButton}" Click="Clear_Click" Margin="12,0,0,0" AutomationProperties.Name="Clear console">
                    <TextBlock Text="Clear"/>
                </Button>
                <Button Style="{StaticResource LinkButton}" Click="Copy_Click" Margin="12,0,0,0" AutomationProperties.Name="Copy console">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconCopy}" Width="14" Height="14"/>
                        <TextBlock Text="Copy" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PlaceButton" Style="{StaticResource IconButton}" Margin="6,0,-6,0" Click="Place_Click">
                    <controls:LineIcon Data="{DynamicResource IconExternal}" Width="15" Height="15"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CollapseButton" Style="{x:Null}" Click="Collapse_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{StaticResource FocusVisual}"
                        AutomationProperties.Name="Show or hide the console lines">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <controls:LineIcon x:Name="Chevron" Data="{DynamicResource IconChevR}" Width="14" Height="14"
                                           Foreground="{DynamicResource Muted2Brush}" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                            <controls:LineIcon.RenderTransform>
                                <RotateTransform x:Name="ChevronTurn" Angle="90"/>
                            </controls:LineIcon.RenderTransform>
                        </controls:LineIcon>
                        <TextBlock Text="Console" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border x:Name="WarningBadge" Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,1" Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconAlert}" Width="12" Height="12" Foreground="{DynamicResource WarnBrush}"/>
                        <TextBlock x:Name="WarningCount" Margin="4,0,0,0" Foreground="{DynamicResource WarnBrush}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ErrorBadge" Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="7,1" Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconX}" Width="12" Height="12" Foreground="{DynamicResource BadBrush}"/>
                        <TextBlock x:Name="ErrorCount" Margin="4,0,0,0" Foreground="{DynamicResource BadBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Lines. -->
        <Border x:Name="Body" Grid.Row="2" Margin="0,8,0,0" Background="{DynamicResource Card2Brush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" ScrollChanged="Scroller_ScrollChanged">
                    <ItemsControl x:Name="LinesList" Margin="10,8" Focusable="False" AutomationProperties.Name="Live console">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Section">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style><Run Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/><Run Text="{Binding Text, StringFormat='  {0}', Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyNote" Margin="12,10" FontSize="12.5" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Docked rails while the console is in its own window. -->
        <DockPanel x:Name="PoppedOutNote" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Bring it back" Click="Place_Click"/>
            <TextBlock Text="Open in its own window." Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
