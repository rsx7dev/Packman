<UserControl x:Class="Packman.Views.StepTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Packman"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RemoteTestViewModel}"
             FontFamily="{StaticResource UIFontFamily}">
    <!-- Body of Remote test, in the wizard's tool frame and on the standalone page.
         The host supplies the PageFrame, footer and the "Test session" rail. -->

    <Border Style="{StaticResource SectionPanel}">
        <StackPanel>

            <!-- Package: the package root staged on the target. -->
            <DockPanel Margin="0,0,0,7">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PackageSourceCaption}" Style="{StaticResource Caption}"/>
                <TextBlock Text="Package" Style="{StaticResource FieldLabel}" Margin="0"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource MonoField}" IsReadOnly="True" FontSize="13"
                         Text="{Binding PackagePath, Mode=OneWay}"
                         local:PlaceholderText.Text="No package selected"
                         AutomationProperties.Name="Package folder"
                         ToolTip="The PSADT package folder staged on the target."/>
                <Button Grid.Column="1" Style="{StaticResource FieldActionButton}" Content="Browse…"
                        Click="BrowsePackage_Click" IsEnabled="{Binding IsIdle}"
                        AutomationProperties.Name="Browse for package"
                        ToolTip="Pick a PSADT package folder on the share to test."/>
            </Grid>
            <TextBlock Text="Generate a package on the Package step and it lands here automatically, or browse to a package already built on the share."
                       Margin="0,8,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"
                       Visibility="{Binding NeedsPackage, Converter={StaticResource BoolToVis}}"/>

            <!-- Target: computer, run context and deploy mode on one row. -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Computer" Style="{StaticResource FieldLabel}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding RecentComputers}"
                              Text="{Binding TargetComputer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsIdle}"
                              AutomationProperties.Name="Computer name"
                              ToolTip="Name of the machine to test on. WinRM must be enabled (Enable-PSRemoting)."/>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="8,0,0,0"
                            Command="{Binding CheckOnlineCommand}"
                            ToolTip="Check the computer is online (ping)">
                        <controls:LineIcon Data="{DynamicResource IconPulse}"/>
                    </Button>
                </Grid>

                <TextBlock Grid.Column="2" Text="Context" Style="{StaticResource FieldLabel}"/>
                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource SegmentGroup}" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ContextToggle}" Content="System" MinWidth="72"
                                     IsChecked="{Binding IsSystemContext, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                     AutomationProperties.Name="Run as System"/>
                        <RadioButton Style="{StaticResource ContextToggle}" Content="User" MinWidth="72"
                                     IsChecked="{Binding RunAsUser, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                     AutomationProperties.Name="Run as the logged-on user"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="4" Text="Deploy mode" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Column="4" Grid.Row="1"
                          ItemsSource="{Binding DeployModes}"
                          SelectedItem="{Binding SelectedDeployMode, Mode=TwoWay}"
                          IsEnabled="{Binding IsIdle}"
                          AutomationProperties.Name="PSADT deploy mode"
                          ToolTip="Appended to the command line as -DeployMode, the same way the publish step does it. Auto leaves the choice to PSADT."/>
            </Grid>

            <TextBlock Text="{Binding ContextHelpText}" Margin="0,10,0,0" FontSize="12" LineHeight="18"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>
            <TextBlock Margin="0,6,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}">
                <Run Text="Runs the Intune command lines from the staged package: "/>
                <Run Text="{Binding CommandPreview, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}"/>
            </TextBlock>
            <CheckBox Content="Delete the staged package from the target after the run"
                      Margin="0,12,0,0" FontSize="12" HorizontalAlignment="Left"
                      IsChecked="{Binding CleanupAfterRun, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                      AutomationProperties.Name="Delete the staged package from the target after the run"
                      ToolTip="Off by default, so a re-run only copies the files that changed."/>

            <!-- Actions -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryButton}" Content="Install" MinWidth="120"
                        Command="{Binding InstallCommand}"
                        ToolTip="Stage the package on the target and run the install command line."/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Uninstall" MinWidth="120" Margin="10,0,0,0"
                        Command="{Binding UninstallCommand}"
                        ToolTip="Stage the package on the target and run the uninstall command line."/>
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Discover detection" Margin="10,0,0,0"
                        Command="{Binding DetectCommand}"
                        ToolTip="Search the target for the installed executable and build a detection rule from it."/>
            </Grid>

            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsCopying, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Copying package: "/><Run Text="{Binding CopyPercent, Mode=OneWay}"/><Run Text="%"/>
                </TextBlock>
                <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100"
                             Value="{Binding CopyPercent, Mode=OneWay}"
                             AutomationProperties.Name="Copying package"/>
            </StackPanel>

            <!-- Detection rule discovered on the target -->
            <Border Style="{StaticResource CalloutOk}" Margin="0,16,0,0"
                    Visibility="{Binding HasDiscoveredRule, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconCheck}" Foreground="{DynamicResource OkBrush}"
                                       VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Detection rule found on the target" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="{Binding DiscoveredSummary}" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>

                        <!-- Only the wizard has a publish step to hand the rule to. -->
                        <StackPanel Visibility="{Binding HasPublishStep, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource LinkButton}" Content="Use this rule for publishing" HorizontalAlignment="Left"
                                    Margin="-2,8,0,0" Command="{Binding ApplyDetectionCommand}"
                                    ToolTip="Replace the publish step's detection rule with this one."/>
                            <TextBlock Text="The publish step holds the wizard's own package, so a package picked from the share cannot feed it."
                                       Margin="0,4,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted2Brush}"
                                       Visibility="{Binding IsSelectedPackage, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SectionRule}"/>

            <!-- Output -->
            <DockPanel Margin="0,0,0,12">
                <!-- The standalone page clears from its footer; the wizard's footer holds navigation. -->
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear"
                        Command="{Binding ClearLogCommand}" AutomationProperties.Name="Clear output"
                        Visibility="{Binding HasPublishStep, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Output" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,14" MinHeight="360" MaxHeight="600">
                <Grid>
                    <TextBlock Text="Output from the device appears here when a test runs."
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource CodeCommentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap">
                                        <Run Foreground="{DynamicResource CodeCommentBrush}" Text="{Binding Time, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Text, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource CodeTxtBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Good">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Warn">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Bad">
                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Dim">
                                                            <Setter Property="Foreground" Value="{DynamicResource CodeCommentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
