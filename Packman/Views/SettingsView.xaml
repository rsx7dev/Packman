<UserControl x:Class="Packman.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <!-- The body keeps its own ScrollViewer (SectionScroll): the preview script scrolls it by name. -->
    <controls:PageFrame Title="Settings"
                        Subtitle="Configure authentication, paths, deployment defaults and appearance"
                        IsBodyScrollable="False">

        <!-- ══ Section tabs ═════════════════════════════════════════════ -->
        <controls:PageFrame.HeaderBottom>
            <WrapPanel>
                <RadioButton x:Name="TabAuth" Style="{StaticResource PageTab}" Content="Authentication" IsChecked="True"/>
                <RadioButton x:Name="TabNetworkPaths" Style="{StaticResource PageTab}" Content="Network paths"/>
                <RadioButton x:Name="TabIntuneDefaults" Style="{StaticResource PageTab}" Content="Intune defaults"/>
                <RadioButton x:Name="TabGroupAssignment" Style="{StaticResource PageTab}" Content="Group assignment"/>
                <RadioButton x:Name="TabCodeSign" Style="{StaticResource PageTab}" Content="Code signing"/>
                <RadioButton x:Name="TabAppearance" Style="{StaticResource PageTab}" Content="Appearance"/>
            </WrapPanel>
        </controls:PageFrame.HeaderBottom>

        <!-- ══ Footer: save feedback, Reset, Save ═══════════════════════ -->
        <controls:PageFrame.Footer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="14,9" Margin="0,0,18,0"
                        Visibility="{Binding SaveStatus, Converter={StaticResource NonEmptyToVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CalloutNeutral}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveStatusKind}" Value="ok">
                                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource OkLineBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SaveStatusKind}" Value="warn">
                                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarnLineBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <controls:LineIcon DockPanel.Dock="Left" Margin="0,0,10,0">
                            <controls:LineIcon.Style>
                                <Style TargetType="controls:LineIcon" BasedOn="{StaticResource {x:Type controls:LineIcon}}">
                                    <Setter Property="Data" Value="{DynamicResource IconInfo}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveStatusKind}" Value="ok">
                                            <Setter Property="Data" Value="{DynamicResource IconCheck}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SaveStatusKind}" Value="warn">
                                            <Setter Property="Data" Value="{DynamicResource IconAlert}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:LineIcon.Style>
                        </controls:LineIcon>
                        <TextBlock Text="{Binding SaveStatus}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,10,0" MinWidth="96"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}" MinWidth="150"/>
                </StackPanel>
            </Grid>
        </controls:PageFrame.Footer>

        <!-- ══ Rail: configuration status ═══════════════════════════════ -->
        <controls:PageFrame.Rail>
            <StackPanel>
                <TextBlock Text="Configuration status" Style="{StaticResource RailTitle}" Margin="0,0,0,6"/>
                <controls:StatusRow Label="Authentication"
                                    Value="{Binding IsSignedIn, Converter={StaticResource BoolToText}, ConverterParameter='Connected|Not connected'}"
                                    Kind="{Binding IsSignedIn, Converter={StaticResource BoolToText}, ConverterParameter='ok|pending'}"/>
                <controls:StatusRow Label="Network paths"
                                    Value="{Binding IsConfigured, Converter={StaticResource BoolToText}, ConverterParameter='Configured|Incomplete'}"
                                    Kind="{Binding IsConfigured, Converter={StaticResource BoolToText}, ConverterParameter='ok|warn'}"/>
                <controls:StatusRow Label="Intune defaults"
                                    Value="{Binding IntuneDefaultsConfigured, Converter={StaticResource BoolToText}, ConverterParameter='Configured|Incomplete'}"
                                    Kind="{Binding IntuneDefaultsConfigured, Converter={StaticResource BoolToText}, ConverterParameter='ok|warn'}"/>
                <controls:StatusRow Label="Code signing" Detail="{Binding CodeSignCertDisplay}"
                                    Value="{Binding CodeSigningEnabled, Converter={StaticResource BoolToText}, ConverterParameter='Enabled|Disabled'}"
                                    Kind="{Binding CodeSigningEnabled, Converter={StaticResource BoolToText}, ConverterParameter='ok|off'}"/>

                <ContentControl Style="{StaticResource KvRow}" Tag="Tenant" Content="{Binding TenantDisplay}" Margin="0,16,0,0"/>
                <ContentControl Tag="Signed in as">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource KvRow}">
                            <Setter Property="Content" Value="{Binding SignedInUser}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSignedIn}" Value="False">
                                    <Setter Property="Content" Value="Not signed in"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl Style="{StaticResource KvRow}" Tag="Permissions" Content="{Binding PermissionSummary}"/>

                <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,18,0,0">
                    <Run Text="Your settings are stored locally at"/>
                    <Run Text="{Binding SettingsPath, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                         Foreground="{DynamicResource Text2Brush}"/>
                </TextBlock>
            </StackPanel>
        </controls:PageFrame.Rail>

        <!-- ══ Body ═════════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="SectionScroll" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- First-run setup banner -->
                <Border Style="{StaticResource CalloutWarn}" Margin="0,0,0,12"
                        Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <controls:LineIcon DockPanel.Dock="Left" Data="{DynamicResource IconBulb}" Foreground="{DynamicResource WarnBrush}"
                                           Margin="0,0,10,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Command="{Binding DismissFirstRunCommand}"
                                VerticalAlignment="Center" ToolTip="Dismiss">
                            <controls:LineIcon Data="{DynamicResource IconX}" Width="12" Height="12"/>
                        </Button>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Margin="0,0,10,0">
                            <Run Text="First-run setup" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                            <Run Text="  Set the package output folder, full PSADT v4 template and IntuneWinAppUtil path. Sign in to Intune, then save."
                                 Foreground="{DynamicResource Text2Brush}"/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SectionPanel}">
                    <Grid>
                        <controls:AuthenticationSettings Visibility="{Binding IsChecked, ElementName=TabAuth, Converter={StaticResource BoolToVis}}"/>
                        <controls:NetworkPathsSettings Visibility="{Binding IsChecked, ElementName=TabNetworkPaths, Converter={StaticResource BoolToVis}}"/>
                        <controls:IntuneDefaultsSettings Visibility="{Binding IsChecked, ElementName=TabIntuneDefaults, Converter={StaticResource BoolToVis}}"/>
                        <controls:GroupAssignmentSettings Visibility="{Binding IsChecked, ElementName=TabGroupAssignment, Converter={StaticResource BoolToVis}}"/>
                        <controls:CodeSigningSettings Visibility="{Binding IsChecked, ElementName=TabCodeSign, Converter={StaticResource BoolToVis}}"/>
                        <controls:AppearanceSettings Visibility="{Binding IsChecked, ElementName=TabAppearance, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </controls:PageFrame>
</UserControl>
