<ui:FluentWindow x:Class="Packman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Packman.Views"
        xmlns:controls="clr-namespace:Packman.Views.Controls"
        xmlns:services="clr-namespace:Packman.Services"
        xmlns:vm="clr-namespace:Packman.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding ScreenTitle, StringFormat='Packman — {0}'}"
        Width="1440" Height="860"
        MinWidth="1080" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        FontSize="13.5"
        Background="{DynamicResource ShellBrush}"
        Foreground="{DynamicResource TextBrush}"
        Closing="MainWindow_Closing">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Bottom menu bar item: always an icon, the label only on the current page. The icon
             geometry comes in through Tag. Checking one checks the matching left-nav button
             (see IsChecked below), so the nav's Checked handlers still do the navigating. -->
        <Style x:Key="MenuBarItem" TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="GroupName" Value="MenuBar"/>
            <Setter Property="Foreground" Value="{DynamicResource DockTextBrush}"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="bd" Height="44" CornerRadius="12" Padding="13,0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:LineIcon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Width="18" Height="18" StrokeThickness="1.7"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter x:Name="label" Visibility="Collapsed" Margin="9,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DockHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DockActiveBrush}"/>
                                <Setter TargetName="label" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource DockActiveTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Shell: title bar with the nav toggle and connection pill, the navigation pane (or, when
         it is hidden, the bottom menu bar), and one page at a time. Every page is a PageFrame
         (Views/Controls/PageFrame.cs): header, body, footer and an inspector rail, as one sheet. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ TITLE BAR ═══════════ -->
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Height="44" Padding="12,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" BorderThickness="0"
                            ToolTip="Toggle navigation (Ctrl+B)" AutomationProperties.Name="Toggle navigation"
                            AutomationProperties.AcceleratorKey="Ctrl+B" Command="{Binding ToggleNavCommand}">
                        <controls:LineIcon Data="{DynamicResource IconPanel}" Width="18" Height="18" StrokeThickness="1.7"/>
                    </Button>
                    <!-- Mark: an amber square with a dark core. -->
                    <Border Width="18" Height="18" CornerRadius="5" Margin="12,0,0,0" Background="{DynamicResource PrimaryBrush}">
                        <Rectangle Width="6" Height="6" RadiusX="2" RadiusY="2" Fill="{DynamicResource PrimaryFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Packman" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <Border Margin="12,0,0,0" Padding="12,0,0,0" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,0,0,0">
                        <TextBlock Text="{Binding ScreenTitle}" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <!-- Connection pill. Clickable: WPF UI treats trailing content as client area. -->
                <Border Margin="0,0,8,0" VerticalAlignment="Center" Height="28" CornerRadius="14" Padding="10,0,12,0"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                        AutomationProperties.Name="{Binding ConnectionStatusText}" ToolTip="{Binding ConnectionStatusText}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MarkBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="·" Margin="8,0" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Sign in" FontSize="12.5" Padding="0"
                                Command="{x:Static services:AppNavigation.OpenSettings}"
                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBlock Text="{Binding TenantName}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ═══════════ BODY ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation pane: transparent so the backdrop carries it. Hidden (and its column
                 collapsed) when the bottom menu bar is showing instead. -->
            <DockPanel Grid.Column="0" LastChildFill="False" Width="208" Margin="8,6,4,10"
                       Visibility="{Binding IsNavHidden, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="CreatePackageNavBtn" Style="{StaticResource NavItem}" IsChecked="True" GroupName="Nav"
                                 Checked="CreatePackageNavBtn_Checked" AutomationProperties.Name="Create package">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconBox}" Width="18" Height="18" StrokeThickness="1.7"/>
                            <TextBlock Text="Create" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UploadIntuneNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="UploadIntuneNavBtn_Checked" AutomationProperties.Name="Upload to Intune">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconUpload}" Width="18" Height="18" StrokeThickness="1.7"/>
                            <TextBlock Text="Upload" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RemoteTestNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="RemoteTestNavBtn_Checked" AutomationProperties.Name="Remote test">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconPulse}" Width="18" Height="18" StrokeThickness="1.7"/>
                            <TextBlock Text="Remote test" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ApplicationsNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="ApplicationsNavBtn_Checked" AutomationProperties.Name="Applications">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconLaptop}" Width="18" Height="18" StrokeThickness="1.7"/>
                            <TextBlock Text="Applications" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AdvancedNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="AdvancedNavBtn_Checked" AutomationProperties.Name="Advanced">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconList}" Width="18" Height="18" StrokeThickness="1.7"/>
                            <TextBlock Text="Advanced" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer: build stamps under Settings. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,12,12,0">
                    <TextBlock Text="PSADT v4 · Graph beta" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding AppVersion, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RuntimeStamp, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <RadioButton x:Name="SettingsNavBtn" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="Nav"
                             Checked="SettingsNavBtn_Checked" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconGear}" Width="18" Height="18" StrokeThickness="1.7"/>
                        <TextBlock Text="Settings" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DockPanel>

            <!-- Pages. Each draws its own panels, so this area stays transparent. -->
            <Grid Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0,0,12,12"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavHidden}" Value="True">
                                <Setter Property="Margin" Value="12,0,12,12"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- ═══════ CREATE PACKAGE ═══════ -->
                <Grid x:Name="CreatePackagePage">
                    <!-- The wizard. Each step scrolls on its own so switching steps
                         doesn't inherit the previous step's scroll position. -->
                    <controls:PageFrame x:Name="CreateFrame" Title="Create package"
                                        Subtitle="Prepare, test and publish a PSADT application to Microsoft Intune"
                                        IsBodyScrollable="False"
                                        Visibility="{Binding IsWizard, Converter={StaticResource BoolToVis}}">
                        <controls:PageFrame.HeaderBottom>
                            <!-- Stepper: numbered discs joined by a rule that fills as steps complete. -->
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,14" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- CommandParameter comes first so the first CanExecute sees the step index. -->
                                            <Button FocusVisualStyle="{StaticResource FocusVisual}" Cursor="Hand"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    AutomationProperties.HelpText="{Binding LockReason}"
                                                    ToolTip="{Binding LockReason}" ToolTipService.ShowOnDisabled="True"
                                                    CommandParameter="{Binding Index}"
                                                    Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="30" Height="30">
                                                        <Ellipse x:Name="disc" Fill="{DynamicResource ControlBrush}"
                                                                 Stroke="{DynamicResource ControlStrokeBrush}" StrokeThickness="1"/>
                                                        <TextBlock x:Name="num" Text="{Binding Number}" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Muted2Brush}"/>
                                                        <Path x:Name="tick" Data="M9.5 15.2l3.6 3.6 7.4-7.6" StrokeThickness="2"
                                                              Stroke="{DynamicResource PrimaryFgBrush}" Visibility="Collapsed"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Grid>
                                                    <TextBlock x:Name="title" Text="{Binding Title}" Margin="12,0,0,0" FontSize="14"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Muted2Brush}"/>
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="line" Grid.Column="1" Height="2" CornerRadius="1" Margin="18,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource EdgeBrush}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="disc" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="disc" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="line" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="disc" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="disc" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource PrimaryFgBrush}"/>
                                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <!-- The last step has nothing to join. -->
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter TargetName="line" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:PageFrame.HeaderBottom>

                        <controls:PageFrame.Footer>
                            <StackPanel>
                                <!-- The running job's status lives here instead of in the page body; a publish shows in the rail. -->
                                <controls:ActivityDock Margin="0,0,0,12" JobName="Generating package" IsIndeterminate="True"
                                                       IsActive="{Binding CreatePackage.IsGenerating}"
                                                       Phase="{Binding CreatePackage.StatusText}"
                                                       CancelCommand="{Binding CreatePackage.CancelCommand}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource BackButton}" Command="{Binding BackCommand}" MinWidth="104"
                                            AutomationProperties.HelpText="{Binding BackLockReason}"
                                            ToolTip="{Binding BackLockReason}" ToolTipService.ShowOnDisabled="True">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                            <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding StepHint}" Margin="18,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FooterHint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsJobRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Command="{Binding PrimaryCommand}" MinWidth="180" Style="{StaticResource PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center"/>
                                            <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </controls:PageFrame.Footer>

                        <controls:PageFrame.Rail>
                            <controls:WizardRail/>
                        </controls:PageFrame.Rail>

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}">
                                <views:StepGenerate/>
                            </ScrollViewer>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}">
                                <views:StepUpload/>
                            </ScrollViewer>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}">
                                <views:StepReview/>
                            </ScrollViewer>
                        </Grid>
                    </controls:PageFrame>

                    <!-- Edit script: covers the wizard. No rail, so the editor gets the width.
                         StepEdit hosts a WebView2, which is HWND-based and ignores WPF clipping,
                         so the body does not scroll; the editor scrolls internally. -->
                    <controls:PageFrame Title="{Binding ToolTitle}" Subtitle="{Binding ToolSubtitle}" IsBodyScrollable="False"
                                        Visibility="{Binding IsEditToolOpen, Converter={StaticResource BoolToVis}}">
                        <controls:PageFrame.Breadcrumb>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Breadcrumb}" Content="Create package" FontFamily="{StaticResource UIFontFamily}"
                                        FontSize="13" Command="{Binding CloseToolCommand}"/>
                                <TextBlock Text="  /  " VerticalAlignment="Center"/>
                                <TextBlock Text="Edit script" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </controls:PageFrame.Breadcrumb>
                        <controls:PageFrame.Footer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BackButton}" Command="{Binding CloseToolCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                        <TextBlock Text="Back to package" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Save lives in the editor toolbar (Ctrl+S). The footer only reports it. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Editor.HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Unsaved changes" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                        <Border Width="1" Height="14" Margin="14,0" Background="{DynamicResource EdgeBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Ctrl+S saves the active file" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueToUploadCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Continue to configure" VerticalAlignment="Center"/>
                                            <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </controls:PageFrame.Footer>
                        <views:StepEdit x:Name="EditStep"/>
                    </controls:PageFrame>

                    <!-- Remote test from inside the wizard: the package is the one just generated. -->
                    <controls:PageFrame Title="{Binding ToolTitle}" Subtitle="{Binding ToolSubtitle}"
                                        Visibility="{Binding IsTestToolOpen, Converter={StaticResource BoolToVis}}">
                        <controls:PageFrame.Breadcrumb>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Breadcrumb}" Content="Create package" FontFamily="{StaticResource UIFontFamily}"
                                        FontSize="13" Command="{Binding CloseToolCommand}"/>
                                <TextBlock Text="  /  " VerticalAlignment="Center"/>
                                <TextBlock Text="Remote test" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </controls:PageFrame.Breadcrumb>
                        <controls:PageFrame.Footer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BackButton}" Command="{Binding CloseToolCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                        <TextBlock Text="Back to package" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1" Style="{StaticResource FooterHint}" Margin="18,0"
                                           Text="Tests run on the device only. Nothing is uploaded to Intune."/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueToUploadCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Continue to configure" VerticalAlignment="Center"/>
                                        <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:PageFrame.Footer>
                        <controls:PageFrame.Rail>
                            <controls:RemoteTestRail DataContext="{Binding RemoteTest}"/>
                        </controls:PageFrame.Rail>
                        <views:StepTest DataContext="{Binding RemoteTest}"/>
                    </controls:PageFrame>
                </Grid>

                <views:RemoteTestView x:Name="RemoteTestPage" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
                <views:UploadToIntuneView x:Name="UploadIntunePage" Visibility="Collapsed"/>
                <views:ApplicationsView x:Name="ApplicationsPage" Visibility="Collapsed"/>
                <views:ApplicationDetailView x:Name="AppDetailPage" Visibility="Collapsed"/>
                <views:AdvancedView x:Name="AdvancedPage" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- ═══════════ MENU BAR (shown instead of the nav) ═══════════ -->
        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="6" CornerRadius="18"
                Background="{DynamicResource DockBrush}"
                Visibility="{Binding IsNavHidden, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource MenuBarItem}" Content="Create" Tag="{DynamicResource IconBox}"
                             IsChecked="{Binding IsChecked, ElementName=CreatePackageNavBtn, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource MenuBarItem}" Content="Upload" Tag="{DynamicResource IconUpload}"
                             IsChecked="{Binding IsChecked, ElementName=UploadIntuneNavBtn, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource MenuBarItem}" Content="Remote test" Tag="{DynamicResource IconPulse}"
                             IsChecked="{Binding IsChecked, ElementName=RemoteTestNavBtn, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource MenuBarItem}" Content="Applications" Tag="{DynamicResource IconLaptop}"
                             IsChecked="{Binding IsChecked, ElementName=ApplicationsNavBtn, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource MenuBarItem}" Content="Advanced" Tag="{DynamicResource IconList}"
                             IsChecked="{Binding IsChecked, ElementName=AdvancedNavBtn, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource MenuBarItem}" Content="Settings" Tag="{DynamicResource IconGear}"
                             IsChecked="{Binding IsChecked, ElementName=SettingsNavBtn, Mode=TwoWay}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
