<ui:FluentWindow x:Class="Packman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Packman.Views"
        xmlns:controls="clr-namespace:Packman.Views.Controls"
        xmlns:services="clr-namespace:Packman.Services"
        xmlns:vm="clr-namespace:Packman.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding ScreenTitle, StringFormat='Packman — {0}'}"
        Width="1440" Height="860"
        MinWidth="1080" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{DynamicResource ShellBrush}"
        Foreground="{DynamicResource TextBrush}"
        Closing="MainWindow_Closing">

    <!-- Shell: title bar with the connection pill, the navigation pane, and one page at a
         time. Every page is a PageFrame (Views/Controls/PageFrame.cs): header, body, footer
         and an inspector rail, as panels on the Mica backdrop. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ TITLE BAR ═══════════ -->
        <ui:TitleBar Grid.Row="0" Height="48" Padding="18,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mark: an outlined square holding a live-state dot. -->
                    <Border Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="1.6">
                        <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource OkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Packman" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <!-- Connection pill. Clickable: WPF UI treats trailing content as client area. -->
                <Border Margin="0,0,14,0" VerticalAlignment="Center" CornerRadius="15" Padding="12,5"
                        Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                        AutomationProperties.Name="{Binding ConnectionStatusText}" ToolTip="{Binding ConnectionStatusText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MarkBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted2Brush}"/>
                        <Border Width="1" Height="14" Margin="10,0" Background="{DynamicResource EdgeBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Sign in" FontSize="12.5" Padding="0"
                                Command="{x:Static services:AppNavigation.OpenSettings}"
                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBlock Text="{Binding TenantName}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentTextBrush}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ═══════════ BODY ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation pane: transparent so the backdrop carries it. -->
            <DockPanel Grid.Column="0" LastChildFill="False" Margin="8,4,8,14">
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="CreatePackageNavBtn" Style="{StaticResource NavItem}" IsChecked="True" GroupName="Nav"
                                 Checked="CreatePackageNavBtn_Checked" AutomationProperties.Name="Create package">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconBox}" Width="19" Height="19" StrokeThickness="1.6"/>
                            <TextBlock Text="Create" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UploadIntuneNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="UploadIntuneNavBtn_Checked" AutomationProperties.Name="Upload to Intune">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconUpload}" Width="19" Height="19" StrokeThickness="1.6"/>
                            <TextBlock Text="Upload" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RemoteTestNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="RemoteTestNavBtn_Checked" AutomationProperties.Name="Remote test">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconLaptop}" Width="19" Height="19" StrokeThickness="1.6"/>
                            <TextBlock Text="Remote test" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ApplicationsNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="ApplicationsNavBtn_Checked" AutomationProperties.Name="Applications">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconList}" Width="19" Height="19" StrokeThickness="1.6"/>
                            <TextBlock Text="Applications" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AdvancedNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="AdvancedNavBtn_Checked" AutomationProperties.Name="Advanced">
                        <StackPanel Orientation="Horizontal">
                            <controls:LineIcon Data="{DynamicResource IconSliders}" Width="19" Height="19" StrokeThickness="1.6"/>
                            <TextBlock Text="Advanced" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer: build stamps under Settings. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,14,12,0">
                    <TextBlock Text="PSADT v4 · GRAPH BETA" FontFamily="{StaticResource LabelFontFamily}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5" Foreground="{DynamicResource FaintBrush}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding AppVersion, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RuntimeStamp, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <RadioButton x:Name="SettingsNavBtn" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="Nav"
                             Checked="SettingsNavBtn_Checked" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <controls:LineIcon Data="{DynamicResource IconGear}" Width="19" Height="19" StrokeThickness="1.6"/>
                        <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DockPanel>

            <!-- Pages. Each draws its own panels, so this area stays transparent. -->
            <Grid Grid.Column="1" Margin="4,4,14,14">
                <!-- ═══════ CREATE PACKAGE ═══════ -->
                <Grid x:Name="CreatePackagePage">
                    <!-- The wizard. Each step scrolls on its own so switching steps
                         doesn't inherit the previous step's scroll position. -->
                    <controls:PageFrame Title="Create package"
                                        Subtitle="Prepare, test and publish a PSADT application to Microsoft Intune"
                                        IsBodyScrollable="False"
                                        Visibility="{Binding IsWizard, Converter={StaticResource BoolToVis}}">
                        <controls:PageFrame.HeaderBottom>
                            <!-- Stepper: numbered discs joined by a rule that fills as steps complete. -->
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,14" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button FocusVisualStyle="{StaticResource FocusVisual}" Cursor="Hand"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding Index}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="30" Height="30">
                                                        <Ellipse x:Name="disc" Fill="{DynamicResource ControlBrush}"
                                                                 Stroke="{DynamicResource ControlStrokeBrush}" StrokeThickness="1"/>
                                                        <TextBlock x:Name="num" Text="{Binding Number}" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Muted2Brush}"/>
                                                        <Path x:Name="tick" Data="M9.5 15.2l3.6 3.6 7.4-7.6" StrokeThickness="2"
                                                              Stroke="{DynamicResource PrimaryFgBrush}" Visibility="Collapsed"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Grid>
                                                    <TextBlock x:Name="title" Text="{Binding Title}" Margin="12,0,0,0" FontSize="14"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Muted2Brush}"/>
                                                </StackPanel>
                                            </Button>
                                            <Border x:Name="line" Grid.Column="1" Height="2" CornerRadius="1" Margin="18,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource EdgeBrush}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="disc" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="disc" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="line" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="disc" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="disc" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource PrimaryFgBrush}"/>
                                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <!-- The last step has nothing to join. -->
                                            <DataTrigger Binding="{Binding Index}" Value="2">
                                                <Setter TargetName="line" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:PageFrame.HeaderBottom>

                        <controls:PageFrame.Footer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BackButton}" Command="{Binding BackCommand}" MinWidth="104">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                        <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding StepHint}" Style="{StaticResource FooterHint}" Margin="18,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="Publishing…" IsEnabled="False"
                                            Visibility="{Binding IsUploadRunning, Converter={StaticResource BoolToVis}}"/>
                                    <Button Command="{Binding PrimaryCommand}" MinWidth="180">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUploadRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center"/>
                                            <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </controls:PageFrame.Footer>

                        <controls:PageFrame.Rail>
                            <controls:WizardRail/>
                        </controls:PageFrame.Rail>

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}">
                                <views:StepGenerate/>
                            </ScrollViewer>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}">
                                <views:StepUpload/>
                            </ScrollViewer>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}">
                                <views:StepReview/>
                            </ScrollViewer>
                        </Grid>
                    </controls:PageFrame>

                    <!-- Edit script: covers the wizard. No rail, so the editor gets the width.
                         StepEdit hosts a WebView2, which is HWND-based and ignores WPF clipping,
                         so the body does not scroll; the editor scrolls internally. -->
                    <controls:PageFrame Title="{Binding ToolTitle}" Subtitle="{Binding ToolSubtitle}" IsBodyScrollable="False"
                                        Visibility="{Binding IsEditToolOpen, Converter={StaticResource BoolToVis}}">
                        <controls:PageFrame.Breadcrumb>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Breadcrumb}" Content="Create package" FontFamily="{StaticResource UIFontFamily}"
                                        FontSize="13" Command="{Binding CloseToolCommand}"/>
                                <TextBlock Text="  /  " VerticalAlignment="Center"/>
                                <TextBlock Text="Edit script" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </controls:PageFrame.Breadcrumb>
                        <controls:PageFrame.Footer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BackButton}" Command="{Binding CloseToolCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                        <TextBlock Text="Back to package" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Save lives in the editor toolbar (Ctrl+S). The footer only reports it. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Editor.HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Unsaved changes" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                        <Border Width="1" Height="14" Margin="14,0" Background="{DynamicResource EdgeBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Ctrl+S saves the active file" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueToUploadCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Continue to configure" VerticalAlignment="Center"/>
                                            <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </controls:PageFrame.Footer>
                        <views:StepEdit x:Name="EditStep"/>
                    </controls:PageFrame>

                    <!-- Remote test from inside the wizard: the package is the one just generated. -->
                    <controls:PageFrame Title="{Binding ToolTitle}" Subtitle="{Binding ToolSubtitle}"
                                        Visibility="{Binding IsTestToolOpen, Converter={StaticResource BoolToVis}}">
                        <controls:PageFrame.Breadcrumb>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Breadcrumb}" Content="Create package" FontFamily="{StaticResource UIFontFamily}"
                                        FontSize="13" Command="{Binding CloseToolCommand}"/>
                                <TextBlock Text="  /  " VerticalAlignment="Center"/>
                                <TextBlock Text="Remote test" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </controls:PageFrame.Breadcrumb>
                        <controls:PageFrame.Footer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BackButton}" Command="{Binding CloseToolCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{DynamicResource IconArrowL}" Width="15" Height="15"/>
                                        <TextBlock Text="Back to package" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1" Style="{StaticResource FooterHint}" Margin="18,0"
                                           Text="Tests run on the device only. Nothing is uploaded to Intune."/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueToUploadCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Continue to configure" VerticalAlignment="Center"/>
                                        <controls:LineIcon Data="{DynamicResource IconArrowR}" Width="15" Height="15" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:PageFrame.Footer>
                        <controls:PageFrame.Rail>
                            <controls:RemoteTestRail DataContext="{Binding RemoteTest}"/>
                        </controls:PageFrame.Rail>
                        <views:StepTest DataContext="{Binding RemoteTest}"/>
                    </controls:PageFrame>
                </Grid>

                <views:RemoteTestView x:Name="RemoteTestPage" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
                <views:UploadToIntuneView x:Name="UploadIntunePage" Visibility="Collapsed"/>
                <views:ApplicationsView x:Name="ApplicationsPage" Visibility="Collapsed"/>
                <views:ApplicationDetailView x:Name="AppDetailPage" Visibility="Collapsed"/>
                <views:AdvancedView x:Name="AdvancedPage" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
