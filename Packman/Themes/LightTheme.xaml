<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Quiet Ledger, light. Every surface is opaque: shell #ECEDEF, page and cards white,
         rail #F8F8F9, hairlines #E5E6EA. One brand amber: the fill carries dark text, the
         darker AccentText step carries amber text and icons. Green/amber/red are status only. -->
    <Color x:Key="BgColor">#FFFFFF</Color>
    <Color x:Key="ShellColor">#ECEDEF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="FlyoutColor">#FFFFFF</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="Card2Color">#F3F4F6</Color>
    <Color x:Key="RailColor">#F8F8F9</Color>
    <Color x:Key="LineColor">#E5E6EA</Color>
    <Color x:Key="Line2Color">#EDEEF1</Color>
    <Color x:Key="Line3Color">#E9EAED</Color>
    <Color x:Key="EdgeColor">#D2D4DA</Color>
    <Color x:Key="Edge2Color">#858993</Color>
    <!-- Boundary of anything you can type in or click: clears 3:1 against the page and the sunk surface. -->
    <Color x:Key="ControlStrokeColor">#858993</Color>
    <Color x:Key="FieldColor">#FFFFFF</Color>
    <!-- Resting / hover surface for outlined controls. -->
    <Color x:Key="ControlColor">#FFFFFF</Color>
    <Color x:Key="ControlHoverColor">#F1F2F4</Color>

    <Color x:Key="InkColor">#16171A</Color>
    <Color x:Key="TextColor">#2A2C32</Color>
    <Color x:Key="Text2Color">#2A2C32</Color>
    <!-- De-emphasis ramp, on the Fluent text alphas. Every step here carries
         text, so each one clears WCAG AA (4.5:1) once composited over the
         surface; MarkColor is the only value below that and is reserved for
         non-text marks — it still clears the 3:1 those need. -->
    <Color x:Key="MutedColor">#5E626C</Color>
    <Color x:Key="Muted2Color">#5E626C</Color>
    <Color x:Key="Muted3Color">#5E626C</Color>
    <Color x:Key="DimColor">#6F737D</Color>
    <Color x:Key="Dim2Color">#6F737D</Color>
    <Color x:Key="FaintColor">#6F737D</Color>
    <Color x:Key="MarkColor">#858993</Color>

    <!-- Success / caution / critical. Caution moves to hue 48: at its old
         #9D5D00 it was one degree off the brand amber, so a warning read as
         brand chrome. -->
    <Color x:Key="OkColor">#16794A</Color>
    <Color x:Key="WarnColor">#855F00</Color>
    <Color x:Key="BadColor">#B3261E</Color>
    <Color x:Key="DangerColor">#B3261E</Color>
    <Color x:Key="OkSoftColor">#E6F4EC</Color>
    <Color x:Key="OkLineColor">#4D16794A</Color>
    <Color x:Key="WarnSoftColor">#FBF1D6</Color>
    <Color x:Key="WarnLineColor">#4D855F00</Color>
    <Color x:Key="BadSoftColor">#FCEAE8</Color>
    <Color x:Key="BadLineColor">#4DB3261E</Color>

    <!-- Accent. The fill keeps the brand hue rather than dropping to a brown,
         and is dark enough to clear 3:1 against the page so the control has a
         visible boundary. PrimaryFgColor is what sits on top of it. -->
    <Color x:Key="PrimaryColor">#DFA24F</Color>
    <Color x:Key="Primary2Color">#D3932F</Color>
    <Color x:Key="PrimaryFgColor">#1B1407</Color>
    <Color x:Key="PrimaryFaintColor">#FBF3E4</Color>
    <Color x:Key="PrimarySoftColor">#FBF3E4</Color>
    <Color x:Key="PrimaryDimColor">#F6E6C6</Color>
    <Color x:Key="PrimaryLineColor">#E9CFA0</Color>
    <!-- Amber as text, an icon or a hairline. The fill above cannot carry text
         on a white panel, so this darker step does that job. -->
    <Color x:Key="AccentTextColor">#8A5508</Color>

    <Color x:Key="CodeBgColor">#F8F8F9</Color>
    <Color x:Key="CodeTxtColor">#2A2C32</Color>
    <Color x:Key="CodeBarTxtColor">#5E626C</Color>
    <Color x:Key="CodeCommentColor">#6F737D</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="FlyoutBrush" Color="{StaticResource FlyoutColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2Color}"/>
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>
    <SolidColorBrush x:Key="Line3Brush" Color="{StaticResource Line3Color}"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}"/>
    <SolidColorBrush x:Key="Edge2Brush" Color="{StaticResource Edge2Color}"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}"/>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Muted2Brush" Color="{StaticResource Muted2Color}"/>
    <SolidColorBrush x:Key="Muted3Brush" Color="{StaticResource Muted3Color}"/>
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}"/>
    <SolidColorBrush x:Key="Dim2Brush" Color="{StaticResource Dim2Color}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
    <!-- Dots, chevrons and state marks. Not text, but they carry meaning,
         so they hold 3:1. -->
    <SolidColorBrush x:Key="MarkBrush" Color="{StaticResource MarkColor}"/>

    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}"/>
    <SolidColorBrush x:Key="OkLineBrush" Color="{StaticResource OkLineColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="{StaticResource WarnLineColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}"/>
    <SolidColorBrush x:Key="BadLineBrush" Color="{StaticResource BadLineColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="Primary2Brush" Color="{StaticResource Primary2Color}"/>
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="{StaticResource PrimaryFgColor}"/>
    <SolidColorBrush x:Key="PrimaryFaintBrush" Color="{StaticResource PrimaryFaintColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimaryDimBrush" Color="{StaticResource PrimaryDimColor}"/>
    <SolidColorBrush x:Key="PrimaryLineBrush" Color="{StaticResource PrimaryLineColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>

    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}"/>
    <SolidColorBrush x:Key="CodeTxtBrush" Color="{StaticResource CodeTxtColor}"/>
    <SolidColorBrush x:Key="CodeBarTxtBrush" Color="{StaticResource CodeBarTxtColor}"/>
    <SolidColorBrush x:Key="CodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>

    <!-- Menubar (shown instead of the left nav when it is hidden). -->
    <Color x:Key="DockColor">#1D2024</Color>
    <Color x:Key="DockHoverColor">#2B2F34</Color>
    <Color x:Key="DockTextColor">#C5CAD0</Color>
    <Color x:Key="DockActiveColor">#F4F5F6</Color>
    <Color x:Key="DockActiveTextColor">#15181C</Color>
    <SolidColorBrush x:Key="DockBrush" Color="{StaticResource DockColor}"/>
    <SolidColorBrush x:Key="DockHoverBrush" Color="{StaticResource DockHoverColor}"/>
    <SolidColorBrush x:Key="DockTextBrush" Color="{StaticResource DockTextColor}"/>
    <SolidColorBrush x:Key="DockActiveBrush" Color="{StaticResource DockActiveColor}"/>
    <SolidColorBrush x:Key="DockActiveTextBrush" Color="{StaticResource DockActiveTextColor}"/>

    <!-- The logo mark is a flat block. -->

    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
