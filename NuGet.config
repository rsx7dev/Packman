<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The solution's packages are vendored in packages/. clear drops any source the
         machine has configured globally. -->
    <clear />
    <add key="packman-offline" value="packages" />
    <!-- Only for the packages mapped to it below: ones whose license terms do not let this
         repository redistribute them. They are listed in third-party/nuget-external.json. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packman-offline">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Management.Infrastructure.Runtime.Win" />
    </packageSource>
  </packageSourceMapping>
</configuration>
