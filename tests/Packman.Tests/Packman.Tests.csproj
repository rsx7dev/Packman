<Project Sdk="Microsoft.NET.Sdk">

  <!-- xunit tests against the real app assembly. Windows only (WPF); run with
       dotnet test tests/Packman.Tests/Packman.Tests.csproj -c Release -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <VSTestTestCaseFilter>FullyQualifiedName~ApplicationRelationshipTests</VSTestTestCaseFilter>
    <!-- The offline feed has no System.Reflection.Metadata / System.Collections.Immutable:
         the test platform's dependencies on them are pruned because the shared framework
         ships both. The .NET 10 SDK default, stated so the restore never depends on it. -->
    <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Packman/Packman.csproj" />
  </ItemGroup>

</Project>
