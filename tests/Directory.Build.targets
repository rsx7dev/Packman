<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeviceStatusUnitTests.cs' Or '$(MSBuildProjectName)' == 'DeviceStatusTests.cs'">
    <Compile Include="$(MSBuildThisFileDirectory)DeviceStatusChecks.cs" />
  </ItemGroup>
  <!-- File-based apps compile one entry file by default. Link the actual production
       sources for the portable harness; Windows tests reference the whole app. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DeviceStatusUnitTests.cs'">
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Services/Intune/IntuneService.DeviceStatusReport.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Models/DeviceInstallStatus.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/CsvWriter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/InstallErrorText.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/JsonExtensions.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PackageLinkTests.cs'">
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/PackageMarker.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/PackageSourceLocator.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UploadConsoleTests.cs'">
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Services/UploadLogger.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Services/IUploadProgress.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/ProcessOutput.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'InstallerInsightTests.cs'">
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Services/InstallerCatalog.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Services/InstallerDetector.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Services/MsiInfoService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/ArgumentLine.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/PsadtScript.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PowerShellLiteralStub.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/TextFileIO.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Packman/Helpers/PsadtLayout.cs" />
  </ItemGroup>
</Project>
