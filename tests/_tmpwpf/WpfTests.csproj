<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PackageLinkWpfTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Packman/Packman.csproj" />
  </ItemGroup>
  <Target Name="RunWpfTests" AfterTargets="Build">
    <Exec Command="&quot;$(TargetDir)PackageLinkWpfTests.exe&quot;" StandardOutputImportance="high" StandardErrorImportance="high" />
  </Target>
</Project>
